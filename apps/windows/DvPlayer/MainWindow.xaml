<ui:FluentWindow x:Class="DvPlayer.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="DV Player"
                 Width="1440" Height="900"
                 MinWidth="1080" MinHeight="680"
                 WindowStartupLocation="CenterScreen"
                 Background="{DynamicResource BgBrush}"
                 ExtendsContentIntoTitleBar="True"
                 StateChanged="OnWindowStateChanged"
                 PreviewMouseLeftButtonDown="OnWindowMouseDown">

  <!-- 没有标题栏：内容从窗口最顶上开始，
       最小化 / 最大化 / 关闭三个按钮自己画在右上角。 -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="216" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- 侧栏：品牌 / 导航 / 连接状态，入口平铺 -->
    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
      <DockPanel>

        <StackPanel DockPanel.Dock="Top" Margin="18,20,18,16">
          <StackPanel Orientation="Horizontal">
            <!-- 品牌图和 exe 图标是同一份位图（scripts/make-icon.py 生成） -->
            <Image Source="Assets/DvPlayer-256.png" Width="32" Height="32"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="DV Player" FontFamily="{StaticResource DisplayFont}"
                         FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
              <TextBlock Text="媒体库" FontSize="12" Foreground="{DynamicResource FaintBrush}" Margin="0,1,0,0" />
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <!-- 底部只留版本：连接状态看服务器列表前面的状态点；
             有新版本时在版本号下面加一行可点的提示 -->
        <StackPanel DockPanel.Dock="Bottom" Margin="20,0,18,18">
          <TextBlock x:Name="VersionText" Text="版本"
                     FontSize="11.5" Foreground="{DynamicResource FaintBrush}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="UpdateHintText" Text="" Visibility="Collapsed"
                     FontSize="11.5" FontWeight="SemiBold"
                     Foreground="{DynamicResource AccentInkBrush}"
                     Cursor="Hand" TextTrimming="CharacterEllipsis"
                     MouseLeftButtonUp="OnVersionHintClick" />
        </StackPanel>

        <!-- 源多了侧栏要能滚：之前是固定 StackPanel，超出窗口就点不到下面的源 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <ListBox x:Name="Nav"
                   Background="Transparent"
                   BorderThickness="0"
                   Margin="0,2,0,0"
                   ItemContainerStyle="{StaticResource NavItem}"
                   PreviewMouseLeftButtonDown="OnNavPreviewMouseDown"
                   SelectionChanged="OnNavSelectionChanged">

            <ListBoxItem Tag="sources">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="15"
                           VerticalAlignment="Center" />
                <TextBlock Text="服务器" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>

            <ListBoxItem Tag="daily">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="15"
                           VerticalAlignment="Center" />
                <TextBlock Text="每日推荐" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>

            <ListBoxItem Tag="records">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="15"
                           VerticalAlignment="Center" />
                <TextBlock Text="记录" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>

            <ListBoxItem Tag="search">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="15"
                           VerticalAlignment="Center" />
                <TextBlock Text="搜索" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>

            <ListBoxItem Tag="settings">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="15"
                           VerticalAlignment="Center" />
                <TextBlock Text="设置" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>
          </ListBox>

          <!-- 服务器：点一项直接进这个源的首页 -->
          <TextBlock Text="服务器" FontSize="11.5" Foreground="{DynamicResource FaintBrush}"
                     Margin="22,20,0,6" />
          <ListBox x:Name="SourceNav"
                   Background="Transparent"
                   BorderThickness="0"
                   Margin="0,0,0,8"
                   ItemContainerStyle="{StaticResource NavItem}"
                   PreviewMouseLeftButtonDown="OnSourceNavPreviewMouseDown"
                   PreviewMouseMove="OnSourceNavPreviewMouseMove"
                   PreviewMouseLeftButtonUp="OnSourceNavPreviewMouseUp"
                   LostMouseCapture="OnSourceNavLostMouseCapture"
                   SelectionChanged="OnSourceSelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Tag="{Binding Id}" Cursor="Hand">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <!-- 名字左边是服务器自己的图标；连没连上用小状态点叠在图标右下角 -->
                  <Grid Grid.Column="0" Width="22" Height="20">
                    <Image Width="18" Height="18" Source="{Binding IconPath}"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <Ellipse Width="7" Height="7" HorizontalAlignment="Right"
                             VerticalAlignment="Bottom" Margin="0,0,0,-1"
                             Stroke="{DynamicResource SidebarBrush}" StrokeThickness="1.5">
                      <Ellipse.Style>
                        <Style TargetType="Ellipse">
                          <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Ok}" Value="True">
                              <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                            </DataTrigger>
                            <!-- 还在建连：灰点，别让人以为已经失败。 -->
                            <DataTrigger Binding="{Binding Pending}" Value="True">
                              <Setter Property="Fill" Value="{DynamicResource FaintBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Ellipse.Style>
                    </Ellipse>
                  </Grid>

                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13.5" Margin="12,0,0,0"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- 内容区 -->
    <Frame x:Name="ContentFrame" Grid.Column="1" NavigationUIVisibility="Hidden"
           Background="{DynamicResource BgBrush}" />

    <!-- 窗口按钮：无标题栏时自己画，46×32 和系统字幕按钮同尺寸 -->
    <StackPanel x:Name="CaptionButtons" Grid.Column="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Panel.ZIndex="50">
      <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}"
              Click="OnMinimizeClick" ToolTip="最小化">
        <TextBlock Text="&#xE921;" FontFamily="{StaticResource IconFont}" FontSize="10" />
      </Button>
      <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}"
              Click="OnMaximizeClick" ToolTip="最大化">
        <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="{StaticResource IconFont}"
                   FontSize="10" />
      </Button>
      <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}"
              Click="OnCloseClick" ToolTip="关闭">
        <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="10" />
      </Button>
    </StackPanel>
  </Grid>
</ui:FluentWindow>
