<ui:FluentWindow x:Class="DvPlayer.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="DV Player"
                 Width="1440" Height="900"
                 MinWidth="1080" MinHeight="680"
                 WindowStartupLocation="CenterScreen"
                 Background="{StaticResource BgBrush}">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="236" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- 侧栏 -->
    <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
      <DockPanel>

        <StackPanel DockPanel.Dock="Top" Margin="20,22,20,18">
          <StackPanel Orientation="Horizontal">
            <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource AccentBrush}">
              <TextBlock Text="&#xE786;" FontFamily="{StaticResource IconFont}" FontSize="15"
                         Foreground="#1A1200" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="DV Player" FontFamily="{StaticResource DisplayFont}"
                         FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
              <TextBlock Text="媒体库" FontSize="11" Foreground="{StaticResource FaintBrush}" Margin="0,1,0,0" />
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <!-- 底部：连接状态 -->
        <Border DockPanel.Dock="Bottom" Margin="14,0,14,14" Padding="12,10"
                CornerRadius="10" Background="{StaticResource SurfaceBrush}">
          <StackPanel>
            <TextBlock x:Name="SourceStatus" Text="未连接"
                       FontSize="12" Foreground="{StaticResource MutedBrush}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="SourceHint" Text="在设置里添加媒体源" FontSize="11"
                       Foreground="{StaticResource FaintBrush}" Margin="0,3,0,0" />
          </StackPanel>
        </Border>

        <ListBox x:Name="Nav"
                 Background="Transparent"
                 BorderThickness="0"
                 Margin="0,4,0,0"
                 ItemContainerStyle="{StaticResource NavItem}"
                 SelectionChanged="OnNavSelectionChanged">

          <ListBoxItem Tag="home">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" FontSize="15"
                         VerticalAlignment="Center" />
              <TextBlock Text="首页" FontSize="13.5" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>

          <ListBoxItem Tag="libraries">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8B2;" FontFamily="{StaticResource IconFont}" FontSize="15"
                         VerticalAlignment="Center" />
              <TextBlock Text="媒体库" FontSize="13.5" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>

          <ListBoxItem Tag="records">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="15"
                         VerticalAlignment="Center" />
              <TextBlock Text="播放记录" FontSize="13.5" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>

          <ListBoxItem Tag="settings">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="15"
                         VerticalAlignment="Center" />
              <TextBlock Text="设置" FontSize="13.5" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- 内容区 -->
    <Frame x:Name="ContentFrame" Grid.Column="1" NavigationUIVisibility="Hidden"
           Background="{StaticResource BgBrush}" />
  </Grid>
</ui:FluentWindow>
