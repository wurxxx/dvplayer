<ui:FluentWindow x:Class="DvPlayer.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="DV Player"
                 Width="1440" Height="900"
                 MinWidth="1080" MinHeight="680"
                 WindowStartupLocation="CenterScreen"
                 Background="{StaticResource BgBrush}"
                 ExtendsContentIntoTitleBar="True"
                 StateChanged="OnWindowStateChanged"
                 PreviewMouseLeftButtonDown="OnWindowMouseDown">

  <!-- 没有标题栏：内容从窗口最顶上开始，
       最小化 / 最大化 / 关闭三个按钮自己画在右上角。 -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="216" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- 侧栏：品牌 / 导航 / 连接状态，入口平铺 -->
    <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
      <DockPanel>

        <StackPanel DockPanel.Dock="Top" Margin="18,20,18,16">
          <StackPanel Orientation="Horizontal">
            <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource AccentBrush}">
              <TextBlock Text="&#xE786;" FontFamily="{StaticResource IconFont}" FontSize="15"
                         Foreground="#1A1200" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="DV Player" FontFamily="{StaticResource DisplayFont}"
                         FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
              <TextBlock Text="媒体库" FontSize="12" Foreground="{StaticResource FaintBrush}" Margin="0,1,0,0" />
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <!-- 底部：连接状态 -->
        <StackPanel DockPanel.Dock="Bottom" Margin="20,0,18,18">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{StaticResource FaintBrush}"
                     VerticalAlignment="Center" />
            <TextBlock x:Name="SourceStatus" Text="未连接"
                       FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <TextBlock x:Name="SourceHint" Text="在「媒体源」里添加" FontSize="11.5"
                     Foreground="{StaticResource FaintBrush}" Margin="14,3,0,0"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel>
          <ListBox x:Name="Nav"
                   Background="Transparent"
                   BorderThickness="0"
                   Margin="0,2,0,0"
                   ItemContainerStyle="{StaticResource NavItem}"
                   SelectionChanged="OnNavSelectionChanged">

            <ListBoxItem Tag="sources">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="15"
                           VerticalAlignment="Center" />
                <TextBlock Text="服务器" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>

            <ListBoxItem Tag="records">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="15"
                           VerticalAlignment="Center" />
                <TextBlock Text="记录" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>

            <ListBoxItem Tag="search">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="15"
                           VerticalAlignment="Center" />
                <TextBlock Text="搜索" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>

            <ListBoxItem Tag="settings">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="15"
                           VerticalAlignment="Center" />
                <TextBlock Text="设置" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>
          </ListBox>

          <!-- 服务器：点一项直接进这个源的首页 -->
          <TextBlock Text="服务器" FontSize="11.5" Foreground="{StaticResource FaintBrush}"
                     Margin="22,20,0,6" />
          <ListBox x:Name="SourceNav"
                   Background="Transparent"
                   BorderThickness="0"
                   Margin="0,0,0,8"
                   ItemContainerStyle="{StaticResource NavItem}"
                   SelectionChanged="OnSourceSelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Tag="{Binding Id}" MouseLeftButtonUp="OnSourceItemClick" Cursor="Hand">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="&#xE774;" FontFamily="{StaticResource IconFont}"
                             FontSize="14" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13.5" Margin="12,0,0,0"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- 内容区 -->
    <Frame x:Name="ContentFrame" Grid.Column="1" NavigationUIVisibility="Hidden"
           Background="{StaticResource BgBrush}" />

    <!-- 窗口按钮：无标题栏时自己画，46×32 和系统字幕按钮同尺寸 -->
    <StackPanel x:Name="CaptionButtons" Grid.Column="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Panel.ZIndex="50">
      <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}"
              Click="OnMinimizeClick" ToolTip="最小化">
        <TextBlock Text="&#xE921;" FontFamily="{StaticResource IconFont}" FontSize="10" />
      </Button>
      <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}"
              Click="OnMaximizeClick" ToolTip="最大化">
        <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="{StaticResource IconFont}"
                   FontSize="10" />
      </Button>
      <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}"
              Click="OnCloseClick" ToolTip="关闭">
        <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="10" />
      </Button>
    </StackPanel>
  </Grid>
</ui:FluentWindow>
