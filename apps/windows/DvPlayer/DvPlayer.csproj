<Project Sdk="Microsoft.NET.Sdk">

  <!-- 本机凭据：直接读仓库外面的 env 文件，本地 dotnet build / dotnet publish
       就和发布包一样带上凭据，不用先跑什么脚本。换了机器只要把
       trakt.env / danmaku.env 放进 %USERPROFILE%\.config\dvplayer\ 就行。
       打包脚本 / CI 用 -p:... 传值，全局属性优先级更高，会盖过这里。 -->
  <PropertyGroup Condition="'$(USERPROFILE)' != '' and Exists('$(USERPROFILE)\.config\dvplayer\trakt.env')">
    <_TraktEnvText>$([System.IO.File]::ReadAllText('$(USERPROFILE)\.config\dvplayer\trakt.env'))</_TraktEnvText>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_TraktEnvText)' != ''">
    <TraktClientId Condition="'$(TraktClientId)' == ''">$([System.Text.RegularExpressions.Regex]::Match($(_TraktEnvText), 'TRAKT_CLIENT_ID\s*=\s*([^\r\n]+)').Groups[1].Value.Trim())</TraktClientId>
    <TraktClientSecret Condition="'$(TraktClientSecret)' == ''">$([System.Text.RegularExpressions.Regex]::Match($(_TraktEnvText), 'TRAKT_CLIENT_SECRET\s*=\s*([^\r\n]+)').Groups[1].Value.Trim())</TraktClientSecret>
  </PropertyGroup>
  <PropertyGroup Condition="'$(USERPROFILE)' != '' and Exists('$(USERPROFILE)\.config\dvplayer\danmaku.env')">
    <_DanmakuEnvText>$([System.IO.File]::ReadAllText('$(USERPROFILE)\.config\dvplayer\danmaku.env'))</_DanmakuEnvText>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_DanmakuEnvText)' != ''">
    <DanmakuAppId Condition="'$(DanmakuAppId)' == ''">$([System.Text.RegularExpressions.Regex]::Match($(_DanmakuEnvText), 'DANMAKU_APP_ID\s*=\s*([^\r\n]+)').Groups[1].Value.Trim())</DanmakuAppId>
    <DanmakuAppSecret Condition="'$(DanmakuAppSecret)' == ''">$([System.Text.RegularExpressions.Regex]::Match($(_DanmakuEnvText), 'DANMAKU_APP_SECRET\s*=\s*([^\r\n]+)').Groups[1].Value.Trim())</DanmakuAppSecret>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DvPlayer</RootNamespace>
    <AssemblyName>DvPlayer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- exe / 任务栏 / Alt-Tab 的图标；图由 scripts/make-icon.py 生成。 -->
    <ApplicationIcon>Assets\DvPlayer.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- 发布版本：打包脚本还会用 -p:Version 覆盖它（build-release.ps1 -Version）。
         界面上「关于」和侧栏显示的就是这个值。 -->
    <Version>0.1.8</Version>
    <!-- 只保留中文和英文的卫星资源。不设这项时 dotnet publish 会把 .NET 自带的
         156 个语言资源 dll 全拷进来（约 8 MB，全是用不上的语言）。
         编译期就不生成，比发布后再删更干净。 -->
    <SatelliteResourceLanguages>zh-Hans;zh-Hant;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <!-- 弹幕（弹弹play）凭据：上面的 env 自动读取（或打包脚本用 -p: 传进来）。
       写成程序集元数据，用户不用也不能在设置里填。两个都为空时运行时就是
       空字符串（弹幕关闭）。 -->
  <ItemGroup Condition="'$(DanmakuAppId)' != '' and '$(DanmakuAppSecret)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DvDanmakuAppId</_Parameter1>
      <_Parameter2>$(DanmakuAppId)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DvDanmakuAppSecret</_Parameter1>
      <_Parameter2>$(DanmakuAppSecret)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Trakt 应用凭据：和弹幕同样的注入方式（env 自动读取 / 打包脚本 -p:）。
       留空时设置页会显示 Client ID / Secret 输入框，用户可以用自己的应用。 -->
  <ItemGroup Condition="'$(TraktClientId)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DvTraktClientId</_Parameter1>
      <_Parameter2>$(TraktClientId)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"
                       Condition="'$(TraktClientSecret)' != ''">
      <_Parameter1>DvTraktClientSecret</_Parameter1>
      <_Parameter2>$(TraktClientSecret)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- 侧栏左上角的品牌图（和 ApplicationIcon 同一份设计，scripts/make-icon.py 生成）。 -->
  <ItemGroup>
    <Resource Include="Assets\DvPlayer-256.png" />
  </ItemGroup>

  <!-- 服务器图标：飞牛 / Emby / Jellyfin / 本地 / SMB / NFS / WebDAV，
       由 scripts/make-source-icons.py 生成（macOS 打包用仓库里同一份）。 -->
  <ItemGroup>
    <Resource Include="Assets\sources\*.png" />
  </ItemGroup>

  <!-- 共享媒体库核心由 scripts/windows/build-core.ps1 生成，构建后拷到输出目录。 -->
  <PropertyGroup>
    <MediaCoreDir>$(MSBuildThisFileDirectory)..\..\..\core\target\x86_64-pc-windows-gnu\release\</MediaCoreDir>
  </PropertyGroup>

  <Target Name="CopyMediaCore" AfterTargets="Build">
    <Copy SourceFiles="$(MediaCoreDir)dvplayer_media.dll"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(MediaCoreDir)dvplayer_media.dll')" />
    <Warning Condition="!Exists('$(MediaCoreDir)dvplayer_media.dll')"
             Text="dvplayer_media.dll 不存在，先运行 scripts/windows/build-core.ps1" />
  </Target>

</Project>
