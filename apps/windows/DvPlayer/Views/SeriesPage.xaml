<Page x:Class="DvPlayer.Views.SeriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgBrush}">

  <ScrollViewer VerticalScrollBarVisibility="Hidden">
    <StackPanel>

      <!-- 顶部背景图：没有 backdrop 的目录用海报模糊撑起来 -->
      <Grid Height="330" ClipToBounds="True">
        <Border x:Name="BackdropBrush">
          <Border.Background>
            <SolidColorBrush Color="#141419" />
          </Border.Background>
        </Border>

        <!-- 没有横版图时，把海报放大模糊当背景 -->
        <Image x:Name="BackdropBlur" Stretch="UniformToFill" Opacity="0.38">
          <Image.Effect>
            <BlurEffect Radius="46" KernelType="Gaussian" />
          </Image.Effect>
        </Image>

        <!-- 压到背景色，避免硬边 -->
        <Border>
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#0008080A" Offset="0" />
              <GradientStop Color="#6608080A" Offset="0.55" />
              <GradientStop Color="#FF08080A" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>

        <Button x:Name="BackButton" Click="OnBackClick" Style="{StaticResource PlayerButton}"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,16,0,0"
                ToolTip="返回（Esc）">
          <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}"
                     FontSize="16" Foreground="#E6FFFFFF" />
        </Button>
      </Grid>

      <!-- 海报 + 信息 -->
      <Grid Margin="40,-120,40,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Width="190" Height="285" CornerRadius="12" Background="#1F1F27"
                VerticalAlignment="Top" SnapsToDevicePixels="True">
          <Grid ClipToBounds="True">
            <Border x:Name="PosterBorder" CornerRadius="12" />
            <TextBlock x:Name="PosterInitial" FontSize="56" FontWeight="SemiBold"
                       Foreground="#2AFFFFFF" HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Grid>
        </Border>

        <StackPanel Grid.Column="1" Margin="26,130,0,0">
          <TextBlock x:Name="TitleText" FontFamily="{StaticResource DisplayFont}"
                     FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                     TextWrapping="Wrap" />
          <TextBlock x:Name="OriginalTitleText" FontSize="13" Foreground="{StaticResource FaintBrush}"
                     Margin="0,5,0,0" TextWrapping="Wrap" />

          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock x:Name="RatingText" FontSize="13" Foreground="{StaticResource AccentBrush}"
                       VerticalAlignment="Center" Margin="0,0,14,0" />
            <TextBlock x:Name="MetaText" FontSize="13" Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel x:Name="TagBar" Orientation="Horizontal" Margin="0,12,0,0" />

          <TextBlock x:Name="OverviewText" FontSize="13" Foreground="#B8B8C2"
                     TextWrapping="Wrap" MaxWidth="760" Margin="0,16,0,0"
                     LineHeight="22" MaxHeight="88" TextTrimming="CharacterEllipsis" />

          <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button x:Name="PlayButton" Style="{StaticResource AccentButton}"
                    Click="OnPlayClick" Padding="22,10">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="13"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="PlayButtonText" Text="播放" FontSize="13.5" FontWeight="SemiBold"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Grid>

      <!-- 季选择 -->
      <ScrollViewer x:Name="SeasonBarHost" HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollBarVisibility="Disabled" Margin="40,34,40,0"
                    Visibility="Collapsed">
        <ItemsControl x:Name="SeasonBar">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Tag="{Binding Id}" MouseLeftButtonUp="OnSeasonClick" Cursor="Hand"
                      CornerRadius="8" Padding="15,7" Margin="0,0,8,0">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource MutedBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Active}" Value="True">
                        <Setter Property="Background" Value="#2E2412" />
                        <Setter Property="TextElement.Foreground" Value="{StaticResource AccentBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock Text="{Binding Title}" FontSize="13" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- 集列表 -->
      <StackPanel Margin="40,20,40,40">
        <TextBlock x:Name="EpisodeHeader" Text="" Style="{StaticResource SectionTitle}"
                   Margin="0,0,0,14" />

        <ItemsControl x:Name="EpisodeList">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Width="226" Margin="0,0,14,18" Cursor="Hand"
                          Tag="{Binding Id}" MouseLeftButtonUp="OnEpisodeClick">
                <Border x:Name="Thumb" Height="127" CornerRadius="9"
                        Background="{Binding Background}" SnapsToDevicePixels="True">
                  <Grid ClipToBounds="True">
                    <TextBlock Text="{Binding Initial}" FontSize="30" FontWeight="SemiBold"
                               Foreground="#2AFFFFFF" HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding PlaceholderVisibility}" />

                    <!-- 集号 -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                            Background="#8C000000" CornerRadius="5" Padding="7,2">
                      <TextBlock Text="{Binding Badge}" FontSize="10.5" Foreground="#F2FFFFFF" />
                    </Border>

                    <!-- 播放态 -->
                    <Border x:Name="HoverVeil" Background="#40000000" Visibility="Collapsed">
                      <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}"
                                 FontSize="26" Foreground="#F2FFFFFF"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- 进度 -->
                    <Border VerticalAlignment="Bottom" Height="3" Background="#33000000">
                      <Border Background="{StaticResource AccentBrush}" HorizontalAlignment="Left"
                              Width="{Binding ProgressWidth}" />
                    </Border>
                  </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="2,9,0,0">
                  <TextBlock Text="{Binding Title}" FontSize="12.5"
                             Foreground="{StaticResource TextBrush}"
                             TextTrimming="CharacterEllipsis" MaxWidth="150" />
                  <TextBlock Text="{Binding Duration}" FontSize="11.5"
                             Foreground="{StaticResource FaintBrush}" Margin="8,0,0,0"
                             VerticalAlignment="Bottom" />
                </StackPanel>
              </StackPanel>
              <DataTemplate.Triggers>
                <Trigger SourceName="Thumb" Property="IsMouseOver" Value="True">
                  <Setter TargetName="HoverVeil" Property="Visibility" Value="Visible" />
                </Trigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Margin="0,8,0,0" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
