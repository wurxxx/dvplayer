<Page x:Class="DvPlayer.Views.SeriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:DvPlayer.Controls"
      Background="{DynamicResource BgBrush}">

  <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Hidden">
    <Grid>

      <!--
        整页背景，和 macOS 详情页同一套：一张图铺满视口高度，
        顶部清晰、往下逐渐模糊，底边淡到页面底色。
        它和正文放在同一个滚动内容里，滚动时跟着一起上移，
        滚过去之后露出页面底色——不是一条固定高度的横幅。
      -->
      <Grid x:Name="HeroBackdrop" VerticalAlignment="Top" Height="470"
            ClipToBounds="True" IsHitTestVisible="False">
        <!-- 清晰图：有横版图用横版图，没有就用海报裁满 -->
        <Border x:Name="BackdropBrush" Background="{DynamicResource SurfaceBrush}" />

        <!--
          同源模糊层：和清晰图同一份几何，只从 26% 处开始渐显，
          越往下越糊（对齐 macOS 的 backdrop mask）。
        -->
        <Border x:Name="BackdropBlur" Visibility="Collapsed">
          <Border.Effect>
            <BlurEffect Radius="36" KernelType="Gaussian" />
          </Border.Effect>
          <Border.OpacityMask>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#00000000" Offset="0.26" />
              <GradientStop Color="#59000000" Offset="0.42" />
              <GradientStop Color="#CC000000" Offset="0.55" />
              <GradientStop Color="#FF000000" Offset="0.68" />
            </LinearGradientBrush>
          </Border.OpacityMask>
        </Border>

        <!--
          白字压在图上的那层黑：顶部给返回按钮，中下部给标题 / 简介。
          有背景图时才打开（没有图就是纯色底，用主题字色）。
        -->
        <Border x:Name="HeroInkVeil" Visibility="Collapsed"
                Background="{DynamicResource HeroInkVeilBrush}" />

        <!--
          底边淡到页面底色。不用 OpacityMask：Grid 里有 BlurEffect 时
          WPF 会把 mask 丢掉，图底变成一条硬边；叠一层同色渐变最稳。
        -->
        <Border Background="{DynamicResource HeroScrimBrush}" />
      </Grid>

      <StackPanel>
      <!--
        顶部信息：左边标题 + 播放，右边评分 / 时长 / 简介。
        背景由上面的 HeroBackdrop 提供，这里只管内容。
      -->
      <Grid x:Name="HeroRoot" MinHeight="470" Background="Transparent">
        <Button x:Name="BackButton" Click="OnBackClick" Style="{StaticResource HeroBackButton}"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,16,0,0"
                ToolTip="返回（Esc）">
          <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}"
                     FontSize="16" Foreground="#E6FFFFFF" />
        </Button>

        <!--
          信息压在横版图下半部：标题 / 原名 / 年份评分 / 标签 / 简介 / 动作按钮，
          竖着排一列（和 macOS 详情页一致）。按钮统一「图标 + 文字」，
          不再用一排看不出含义的圆形图标。
        -->
        <StackPanel VerticalAlignment="Bottom" Margin="40,140,40,26">
          <StackPanel MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock x:Name="TitleText" FontFamily="{StaticResource DisplayFont}"
                       FontSize="31" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="OriginalTitleText" FontSize="13" Foreground="{DynamicResource FaintBrush}"
                       Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <TextBlock x:Name="RatingText" FontSize="14.5" FontWeight="SemiBold"
                         Foreground="{DynamicResource AccentInkBrush}" VerticalAlignment="Center"
                         Margin="0,0,16,0" Visibility="Collapsed" />
              <TextBlock x:Name="MetaText" FontSize="13.5" Foreground="{DynamicResource MutedBrush}"
                         VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel x:Name="TagBar" Orientation="Horizontal" Margin="0,11,0,0" />

            <TextBlock x:Name="OverviewText" FontSize="13.5" Foreground="{DynamicResource MutedBrush}"
                       TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="22"
                       MaxHeight="88" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />

            <!-- 动作按钮：顺序和 macOS 一致（播放 / 重头看 / 收藏 / 已观看 / 音轨 / 字幕） -->
            <WrapPanel Margin="0,20,0,0">
              <Button x:Name="PlayButton" Style="{StaticResource HeroPlayButton}"
                      Click="OnPlayClick">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="14"
                             VerticalAlignment="Center" />
                  <TextBlock x:Name="PlayButtonText" Text="播放" FontSize="14" FontWeight="SemiBold"
                             Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <Button x:Name="RestartButton" Style="{StaticResource HeroActionButton}"
                      Click="OnRestartClick" ToolTip="重头看">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="14"
                             VerticalAlignment="Center" />
                  <TextBlock Text="重头看" FontSize="13.5"
                             Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <Button x:Name="FavoriteButton" Style="{StaticResource HeroActionButton}"
                      Click="OnFavoriteClick">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="FavoriteGlyph" Text="&#xE734;"
                             FontFamily="{StaticResource IconFont}" FontSize="14"
                             Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                  <TextBlock x:Name="FavoriteLabel" Text="加入收藏" FontSize="13.5"
                             Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <Button x:Name="WatchedButton" Style="{StaticResource HeroActionButton}"
                      Click="OnWatchedClick">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="WatchedGlyph" Text="&#xE73E;"
                             FontFamily="{StaticResource IconFont}" FontSize="14"
                             Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                  <TextBlock x:Name="WatchedLabel" Text="标记为已观看" FontSize="13.5"
                             Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <!-- 只有多音轨 / 有字幕时才出现 -->
              <Button x:Name="AudioButton" Style="{StaticResource HeroActionButton}"
                      Click="OnAudioClick" Visibility="Collapsed" ToolTip="选择音轨">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="14"
                             VerticalAlignment="Center" />
                  <TextBlock x:Name="AudioLabel" Text="音轨" FontSize="13.5"
                             Margin="8,0,0,0" VerticalAlignment="Center"
                             MaxWidth="120" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Button>

              <Button x:Name="SubtitleButton" Style="{StaticResource HeroActionButton}"
                      Click="OnSubtitleClick" Visibility="Collapsed" ToolTip="选择字幕">
                <StackPanel Orientation="Horizontal">
                  <Viewbox Width="17" Height="15" VerticalAlignment="Center">
                    <Canvas Width="20" Height="18">
                      <Rectangle Canvas.Left="1" Canvas.Top="2" Width="18" Height="14"
                                 RadiusX="3.5" RadiusY="3.5"
                                 Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" />
                      <Rectangle Canvas.Left="4.2" Canvas.Top="10" Width="6.4" Height="3.2"
                                 RadiusX="1.2" RadiusY="1.2" Fill="{DynamicResource TextBrush}" />
                      <Rectangle Canvas.Left="12.4" Canvas.Top="10" Width="3.4" Height="3.2"
                                 RadiusX="1.2" RadiusY="1.2" Fill="{DynamicResource TextBrush}" />
                    </Canvas>
                  </Viewbox>
                  <TextBlock x:Name="SubtitleLabel" Text="字幕" FontSize="13.5"
                             Margin="8,0,0,0" VerticalAlignment="Center"
                             MaxWidth="120" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Button>
              <!-- Trakt：评分 / 收藏 / 待看（没连接时点开会提示去设置）。 -->
              <Button x:Name="TraktButton" Style="{StaticResource HeroActionButton}"
                      Click="OnTraktClick" ToolTip="Trakt：评分 / 收藏 / 待看">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="14"
                             VerticalAlignment="Center" />
                  <TextBlock Text="Trakt" FontSize="13.5"
                             Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </WrapPanel>
          </StackPanel>
        </StackPanel>
      </Grid>

      <!-- 季选择 + 集：横向一行，鼠标移上去两侧出箭头 -->
      <StackPanel x:Name="EpisodeSection" Margin="40,22,40,0" Visibility="Collapsed">

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="SeasonPicker" Click="OnSeasonPickerClick" Cursor="Hand"
                  HorizontalAlignment="Left" VerticalAlignment="Center">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border Background="Transparent" Padding="0">
                  <ContentPresenter VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.72" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="SeasonPickerText" FontFamily="{StaticResource DisplayFont}"
                         FontSize="19" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
              <TextBlock x:Name="SeasonPickerChevron" Text="&#xE70D;"
                         FontFamily="{StaticResource IconFont}" FontSize="11"
                         Foreground="{DynamicResource MutedBrush}" Margin="9,3,0,0"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <TextBlock x:Name="EpisodeCountText" Style="{StaticResource Caption}"
                     Margin="14,3,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <!-- 集数多时按 30 集一段铺快捷入口：1-30 / 31-60 …，放不下就换行。
             做成换行而不是横向滚动：这行没有箭头，横向滚不到后面就点不回前面那几段。 -->
        <ItemsControl x:Name="RangeRow" Margin="0,12,0,0" Visibility="Collapsed">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <!-- 换行后行与行之间要留出间距，否则两排段按钮会贴在一起 -->
                <Border Tag="{Binding}" MouseLeftButtonUp="OnRangeClick" Cursor="Hand"
                        CornerRadius="7" Padding="11,5" Margin="0,0,8,8">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                      <Setter Property="TextElement.Foreground" Value="{DynamicResource MutedBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Active}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                          <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentInkBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Text="{Binding Title}" FontSize="12.5" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        <Grid Margin="0,16,0,0">
          <controls:HorizontalRow x:Name="EpisodeScroller">
            <ItemsControl x:Name="EpisodeList">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Width="296" Margin="0,0,18,6" Cursor="Hand"
                              Tag="{Binding Id}" MouseLeftButtonUp="OnEpisodeClick">
                    <Border x:Name="Thumb" Height="166" CornerRadius="10"
                            BorderThickness="2" BorderBrush="Transparent"
                            Background="{Binding Background}" SnapsToDevicePixels="True">
                      <Grid ClipToBounds="True">
                        <TextBlock Text="{Binding Initial}" FontSize="34" FontWeight="SemiBold"
                                   Foreground="#2AFFFFFF" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding PlaceholderVisibility}" />

                        <!-- 播放态 -->
                        <Border x:Name="HoverVeil" Background="#40000000" Visibility="Collapsed">
                          <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}"
                                     FontSize="28" Foreground="#F2FFFFFF"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- 进度：往里缩 4px，贴着底边会和强调色描边连成一条 -->
                        <Border VerticalAlignment="Bottom" Height="3" Margin="4,0,4,4"
                                CornerRadius="1.5" Background="#59000000"
                                Visibility="{Binding ProgressVisibility}">
                          <Border x:Name="ProgressFill" CornerRadius="1.5"
                                  Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left"
                                  Width="{Binding ProgressWidth}" />
                        </Border>
                      </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="2,9,0,0">
                      <TextBlock x:Name="BadgeText" Text="{Binding Badge}" FontSize="13.5" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                      <TextBlock Text="·" FontSize="13.5" Margin="7,0"
                                 Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Title}" FontSize="13.5"
                                 Foreground="{DynamicResource MutedBrush}"
                                 TextTrimming="CharacterEllipsis" MaxWidth="212"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>
                  <DataTemplate.Triggers>
                    <Trigger SourceName="Thumb" Property="IsMouseOver" Value="True">
                      <Setter TargetName="HoverVeil" Property="Visibility" Value="Visible" />
                    </Trigger>
                    <!-- 看到一半的那一集：强调描边 + 集号变色 -->
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                      <Setter TargetName="Thumb" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                      <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
                      <!-- 进度条改成白色：强调色描边和强调色进度各管一件事，不互相吃色 -->
                      <Setter TargetName="ProgressFill" Property="Background" Value="#F2FFFFFF" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </controls:HorizontalRow>

          <Button x:Name="EpisodeLeftButton" Style="{StaticResource RowArrowButton}"
                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,18"
                  Click="OnEpisodeScrollLeft">
            <TextBlock Text="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="15"
                       Foreground="{DynamicResource TextBrush}" />
          </Button>
          <Button x:Name="EpisodeRightButton" Style="{StaticResource RowArrowButton}"
                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,18"
                  Click="OnEpisodeScrollRight">
            <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="15"
                       Foreground="{DynamicResource TextBrush}" />
          </Button>
        </Grid>
      </StackPanel>

      <!-- 资源：同一部片在各源的条目；单源也显示一行，点一张切源 -->
      <StackPanel x:Name="SourcesSection" Margin="40,32,40,0" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="资源" Style="{StaticResource SectionTitle}" />
          <TextBlock x:Name="SourcesCount" Style="{StaticResource Caption}"
                     VerticalAlignment="Bottom" Margin="8,0,0,2" />
        </StackPanel>

        <Grid Margin="0,14,0,0">
          <controls:HorizontalRow x:Name="SourcesScroller">
            <ItemsControl x:Name="SourcesList">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Width="250" Margin="0,0,14,4" Padding="16,13" CornerRadius="10"
                          Cursor="Hand" Background="{DynamicResource SurfaceBrush}"
                          BorderBrush="{Binding BorderBrush}" BorderThickness="{Binding BorderThickness}"
                          Tag="{Binding Id}" MouseLeftButtonUp="OnSourceClick">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Border Background="{Binding BadgeBackground}" CornerRadius="4"
                                Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding BadgeVisibility}">
                          <TextBlock Text="{Binding Badge}" FontSize="10.5"
                                     Foreground="{Binding BadgeBrush}" />
                        </Border>
                      </StackPanel>

                      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="5"
                                Padding="7,2" VerticalAlignment="Center"
                                Visibility="{Binding ResolutionVisibility}">
                          <TextBlock Text="{Binding Resolution}" FontSize="11.5"
                                     Foreground="{DynamicResource MutedBrush}" />
                        </Border>
                        <TextBlock Text="{Binding Progress}" FontSize="11.5"
                                   Foreground="{DynamicResource FaintBrush}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </controls:HorizontalRow>

          <Button x:Name="SourcesLeftButton" Style="{StaticResource RowArrowButton}"
                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,18"
                  Click="OnSourcesScrollLeft">
            <TextBlock Text="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="15"
                       Foreground="{DynamicResource TextBrush}" />
          </Button>
          <Button x:Name="SourcesRightButton" Style="{StaticResource RowArrowButton}"
                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,18"
                  Click="OnSourcesScrollRight">
            <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="15"
                       Foreground="{DynamicResource TextBrush}" />
          </Button>
        </Grid>
      </StackPanel>

      <!-- 演职人员 -->
      <StackPanel x:Name="CastSection" Margin="40,32,40,0" Visibility="Collapsed">
        <TextBlock Text="演职人员" Style="{StaticResource SectionTitle}" />

        <Grid Margin="0,14,0,0">
          <controls:HorizontalRow x:Name="CastScroller">
            <ItemsControl x:Name="CastList">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Width="96" Margin="0,0,16,4" Cursor="Hand"
                              Tag="{Binding PersonId}" MouseLeftButtonUp="OnCastClick">
                    <Border Height="118" CornerRadius="10" Background="{Binding Background}"
                            SnapsToDevicePixels="True">
                      <Grid ClipToBounds="True">
                        <TextBlock Text="{Binding Initial}" FontSize="30" FontWeight="SemiBold"
                                   Foreground="#2AFFFFFF" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding PlaceholderVisibility}" />
                      </Grid>
                    </Border>

                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" Margin="0,8,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Role}" FontSize="12.5"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding RoleVisibility}" />
                    <TextBlock Text="{Binding Job}" FontSize="11.5"
                               Foreground="{DynamicResource FaintBrush}" Margin="0,3,0,0"
                               Visibility="{Binding JobVisibility}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </controls:HorizontalRow>

          <Button x:Name="CastLeftButton" Style="{StaticResource RowArrowButton}"
                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,30"
                  Click="OnCastScrollLeft">
            <TextBlock Text="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="15"
                       Foreground="{DynamicResource TextBrush}" />
          </Button>
          <Button x:Name="CastRightButton" Style="{StaticResource RowArrowButton}"
                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,30"
                  Click="OnCastScrollRight">
            <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="15"
                       Foreground="{DynamicResource TextBrush}" />
          </Button>
        </Grid>
      </StackPanel>

      <!-- 链接 -->
      <StackPanel x:Name="LinksSection" Margin="40,32,40,0" Visibility="Collapsed">
        <TextBlock Text="链接" Style="{StaticResource SectionTitle}" />
        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
          <Border x:Name="DoubanButton" CornerRadius="18" Padding="15,8" Cursor="Hand"
                  Background="{DynamicResource SurfaceBrush}"
                  MouseLeftButtonUp="OnDoubanClick">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE71B;" FontFamily="{StaticResource IconFont}" FontSize="12.5"
                         Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
              <TextBlock Text="豆瓣" FontSize="13" Foreground="{DynamicResource TextBrush}"
                         Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <!-- 服务器刮削时记下了 id 才显示（Emby / Jellyfin）；飞牛这类没有就不摆。 -->
          <Border x:Name="TmdbButton" CornerRadius="18" Padding="15,8" Cursor="Hand"
                  Margin="8,0,0,0" Visibility="Collapsed"
                  Background="{DynamicResource SurfaceBrush}"
                  MouseLeftButtonUp="OnTmdbClick">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE71B;" FontFamily="{StaticResource IconFont}" FontSize="12.5"
                         Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
              <TextBlock Text="TMDB" FontSize="13" Foreground="{DynamicResource TextBrush}"
                         Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <Border x:Name="ImdbButton" CornerRadius="18" Padding="15,8" Cursor="Hand"
                  Margin="8,0,0,0" Visibility="Collapsed"
                  Background="{DynamicResource SurfaceBrush}"
                  MouseLeftButtonUp="OnImdbClick">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE71B;" FontFamily="{StaticResource IconFont}" FontSize="12.5"
                         Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
              <TextBlock Text="IMDb" FontSize="13" Foreground="{DynamicResource TextBrush}"
                         Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>

      <!-- 媒体信息：视频、音频各一张卡，横向排开 -->
      <StackPanel x:Name="MediaInfoSection" Margin="40,32,40,20" Visibility="Collapsed">
        <TextBlock x:Name="MediaInfoTitle" Text="媒体信息" Style="{StaticResource SectionTitle}" />

        <Grid Margin="0,14,0,0">
          <controls:HorizontalRow x:Name="MediaInfoScroller">
            <StackPanel x:Name="MediaInfoPanel" Orientation="Horizontal" />
          </controls:HorizontalRow>

          <Button x:Name="MediaInfoLeftButton" Style="{StaticResource RowArrowButton}"
                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,18"
                  Click="OnMediaInfoScrollLeft">
            <TextBlock Text="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="15"
                       Foreground="{DynamicResource TextBrush}" />
          </Button>
          <Button x:Name="MediaInfoRightButton" Style="{StaticResource RowArrowButton}"
                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,18"
                  Click="OnMediaInfoScrollRight">
            <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="15"
                       Foreground="{DynamicResource TextBrush}" />
          </Button>
        </Grid>
      </StackPanel>

      <!-- 存储位置：电影 / 单集给完整文件路径，剧集 / 季给所在目录 -->
      <StackPanel x:Name="LocationSection" Margin="40,10,40,16" Visibility="Collapsed">
        <TextBlock Text="存储位置" Style="{StaticResource SectionTitle}" />

        <Grid Margin="0,11,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" Text="&#xE8B7;" FontFamily="{StaticResource IconFont}"
                     FontSize="12" Foreground="{DynamicResource FaintBrush}"
                     VerticalAlignment="Top" Margin="0,2,8,0" />
          <TextBlock Grid.Column="1" x:Name="LocationText" FontSize="12.5"
                     Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                     LineHeight="19"
                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Grid>
      </StackPanel>

      <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Margin="40,10,40,40" />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Page>
