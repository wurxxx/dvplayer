<Page x:Class="DvPlayer.Views.SeriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgBrush}">

  <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Hidden">
    <StackPanel>

      <!-- 顶部背景图：没有 backdrop 的目录用海报模糊撑起来 -->
      <Grid Height="330" ClipToBounds="True">
        <Border x:Name="BackdropBrush">
          <Border.Background>
            <SolidColorBrush Color="#1F1F27" />
          </Border.Background>
        </Border>

        <!-- 没有横版图时，把海报放大模糊当背景 -->
        <Image x:Name="BackdropBlur" Stretch="UniformToFill" Opacity="0.38">
          <Image.Effect>
            <BlurEffect Radius="46" KernelType="Gaussian" />
          </Image.Effect>
        </Image>

        <!-- 压到背景色，避免硬边 -->
        <Border>
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#000E0E12" Offset="0" />
              <GradientStop Color="#660E0E12" Offset="0.55" />
              <GradientStop Color="#FF0E0E12" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>

        <Button x:Name="BackButton" Click="OnBackClick" Style="{StaticResource PlayerButton}"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,16,0,0"
                ToolTip="返回（Esc）">
          <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}"
                     FontSize="16" Foreground="#E6FFFFFF" />
        </Button>
      </Grid>

      <!-- 海报 + 信息 -->
      <Grid Margin="40,-120,40,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Width="190" Height="285" CornerRadius="12" Background="#1F1F27"
                VerticalAlignment="Top" SnapsToDevicePixels="True">
          <Grid ClipToBounds="True">
            <Border x:Name="PosterBorder" CornerRadius="12" />
            <TextBlock x:Name="PosterInitial" FontSize="56" FontWeight="SemiBold"
                       Foreground="#2AFFFFFF" HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Grid>
        </Border>

        <StackPanel Grid.Column="1" Margin="26,130,0,0">
          <TextBlock x:Name="TitleText" FontFamily="{StaticResource DisplayFont}"
                     FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                     TextWrapping="Wrap" />
          <TextBlock x:Name="OriginalTitleText" FontSize="13.5" Foreground="{StaticResource FaintBrush}"
                     Margin="0,5,0,0" TextWrapping="Wrap" />

          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock x:Name="RatingText" FontSize="13.5" Foreground="{StaticResource AccentBrush}"
                       VerticalAlignment="Center" Margin="0,0,14,0" />
            <TextBlock x:Name="MetaText" FontSize="13.5" Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel x:Name="TagBar" Orientation="Horizontal" Margin="0,12,0,0" />

          <TextBlock x:Name="OverviewText" FontSize="13.5" Foreground="#B8B8C2"
                     TextWrapping="Wrap" MaxWidth="760" Margin="0,16,0,0"
                     LineHeight="22" MaxHeight="88" TextTrimming="CharacterEllipsis" />

          <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button x:Name="PlayButton" Style="{StaticResource AccentButton}"
                    Click="OnPlayClick" Padding="22,10">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="13.5"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="PlayButtonText" Text="播放" FontSize="14" FontWeight="SemiBold"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Grid>

      <!-- 季选择 + 集：横向一行，鼠标移上去两侧出箭头 -->
      <StackPanel x:Name="EpisodeSection" Margin="40,32,40,0" Visibility="Collapsed">

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="SeasonPicker" Click="OnSeasonPickerClick" Cursor="Hand"
                  HorizontalAlignment="Left" VerticalAlignment="Center">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border Background="Transparent" Padding="0">
                  <ContentPresenter VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.72" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="SeasonPickerText" FontFamily="{StaticResource DisplayFont}"
                         FontSize="19" FontWeight="SemiBold"
                         Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
              <TextBlock x:Name="SeasonPickerChevron" Text="&#xE70D;"
                         FontFamily="{StaticResource IconFont}" FontSize="11"
                         Foreground="{StaticResource MutedBrush}" Margin="9,3,0,0"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <TextBlock x:Name="EpisodeCountText" Style="{StaticResource Caption}"
                     Margin="14,3,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <Grid Margin="0,16,0,0">
          <ScrollViewer x:Name="EpisodeScroller"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled"
                        PreviewMouseWheel="OnEpisodeWheel">
            <ItemsControl x:Name="EpisodeList">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Width="296" Margin="0,0,18,6" Cursor="Hand"
                              Tag="{Binding Id}" MouseLeftButtonUp="OnEpisodeClick">
                    <Border x:Name="Thumb" Height="166" CornerRadius="10"
                            Background="{Binding Background}" SnapsToDevicePixels="True">
                      <Grid ClipToBounds="True">
                        <TextBlock Text="{Binding Initial}" FontSize="34" FontWeight="SemiBold"
                                   Foreground="#2AFFFFFF" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding PlaceholderVisibility}" />

                        <!-- 播放态 -->
                        <Border x:Name="HoverVeil" Background="#40000000" Visibility="Collapsed">
                          <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}"
                                     FontSize="28" Foreground="#F2FFFFFF"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- 进度 -->
                        <Border VerticalAlignment="Bottom" Height="3" Background="#33000000"
                                Visibility="{Binding ProgressVisibility}">
                          <Border Background="{StaticResource AccentBrush}" HorizontalAlignment="Left"
                                  Width="{Binding ProgressWidth}" />
                        </Border>
                      </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="2,9,0,0">
                      <TextBlock Text="{Binding Badge}" FontSize="13.5" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                      <TextBlock Text="·" FontSize="13.5" Margin="7,0"
                                 Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Title}" FontSize="13.5"
                                 Foreground="{StaticResource MutedBrush}"
                                 TextTrimming="CharacterEllipsis" MaxWidth="212"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>
                  <DataTemplate.Triggers>
                    <Trigger SourceName="Thumb" Property="IsMouseOver" Value="True">
                      <Setter TargetName="HoverVeil" Property="Visibility" Value="Visible" />
                    </Trigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <Button x:Name="EpisodeLeftButton" Style="{StaticResource RowArrowButton}"
                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,18"
                  Click="OnEpisodeScrollLeft">
            <TextBlock Text="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="15"
                       Foreground="{StaticResource TextBrush}" />
          </Button>
          <Button x:Name="EpisodeRightButton" Style="{StaticResource RowArrowButton}"
                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,18"
                  Click="OnEpisodeScrollRight">
            <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="15"
                       Foreground="{StaticResource TextBrush}" />
          </Button>
        </Grid>
      </StackPanel>

      <!-- 演职人员 -->
      <StackPanel x:Name="CastSection" Margin="40,32,40,0" Visibility="Collapsed">
        <TextBlock Text="演职人员" Style="{StaticResource SectionTitle}" />

        <Grid Margin="0,14,0,0">
          <ScrollViewer x:Name="CastScroller"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled"
                        PreviewMouseWheel="OnEpisodeWheel">
            <ItemsControl x:Name="CastList">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Width="96" Margin="0,0,16,4">
                    <Border Height="118" CornerRadius="10" Background="{Binding Background}"
                            SnapsToDevicePixels="True">
                      <Grid ClipToBounds="True">
                        <TextBlock Text="{Binding Initial}" FontSize="30" FontWeight="SemiBold"
                                   Foreground="#2AFFFFFF" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding PlaceholderVisibility}" />
                      </Grid>
                    </Border>

                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Role}" FontSize="12.5"
                               Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding RoleVisibility}" />
                    <TextBlock Text="{Binding Job}" FontSize="11.5"
                               Foreground="{StaticResource FaintBrush}" Margin="0,3,0,0"
                               Visibility="{Binding JobVisibility}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <Button x:Name="CastLeftButton" Style="{StaticResource RowArrowButton}"
                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,30"
                  Click="OnCastScrollLeft">
            <TextBlock Text="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="15"
                       Foreground="{StaticResource TextBrush}" />
          </Button>
          <Button x:Name="CastRightButton" Style="{StaticResource RowArrowButton}"
                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,30"
                  Click="OnCastScrollRight">
            <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="15"
                       Foreground="{StaticResource TextBrush}" />
          </Button>
        </Grid>
      </StackPanel>

      <!-- 链接 -->
      <StackPanel x:Name="LinksSection" Margin="40,32,40,0" Visibility="Collapsed">
        <TextBlock Text="链接" Style="{StaticResource SectionTitle}" />
        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
          <Border x:Name="DoubanButton" CornerRadius="18" Padding="15,8" Cursor="Hand"
                  Background="{StaticResource SurfaceBrush}"
                  MouseLeftButtonUp="OnDoubanClick">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE71B;" FontFamily="{StaticResource IconFont}" FontSize="12.5"
                         Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
              <TextBlock Text="豆瓣" FontSize="13" Foreground="{StaticResource TextBrush}"
                         Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>

      <!-- 媒体信息：视频、音频各一张卡，横向排开 -->
      <StackPanel x:Name="MediaInfoSection" Margin="40,32,40,40" Visibility="Collapsed">
        <TextBlock Text="媒体信息" Style="{StaticResource SectionTitle}" />

        <Grid Margin="0,14,0,0">
          <ScrollViewer x:Name="MediaInfoScroller"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled"
                        PreviewMouseWheel="OnEpisodeWheel">
            <StackPanel x:Name="MediaInfoPanel" Orientation="Horizontal" />
          </ScrollViewer>

          <Button x:Name="MediaInfoLeftButton" Style="{StaticResource RowArrowButton}"
                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,18"
                  Click="OnMediaInfoScrollLeft">
            <TextBlock Text="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="15"
                       Foreground="{StaticResource TextBrush}" />
          </Button>
          <Button x:Name="MediaInfoRightButton" Style="{StaticResource RowArrowButton}"
                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,18"
                  Click="OnMediaInfoScrollRight">
            <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="15"
                       Foreground="{StaticResource TextBrush}" />
          </Button>
        </Grid>
      </StackPanel>

      <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Margin="40,10,40,40" />
    </StackPanel>
  </ScrollViewer>
</Page>
