<Page x:Class="DvPlayer.Views.SearchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:DvPlayer.Controls"
      Background="{StaticResource BgBrush}">

  <Grid Margin="32,24,32,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 统一工具条：标题 + 搜索框（搜索框放在顶栏） -->
    <Grid Height="52">
      <TextBlock Text="搜索" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />

      <Border Style="{StaticResource SearchBoxBorder}" HorizontalAlignment="Right"
              VerticalAlignment="Center" Width="340">
        <Grid>
          <TextBlock Text="&#xE721;" Style="{StaticResource SearchBoxIcon}" />
          <TextBox x:Name="SearchBox" Style="{StaticResource SearchBoxInput}"
                   TextChanged="OnSearchTextChanged" />
          <TextBlock x:Name="SearchPlaceholder" Text="搜索所有媒体库"
                     Style="{StaticResource SearchBoxPlaceholder}" />
        </Grid>
      </Border>
    </Grid>

    <!-- 分段：媒体库 / 记录 -->
    <StackPanel Grid.Row="1" Margin="0,14,0,0">
      <Border Style="{StaticResource SegmentGroup}">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="MediaSegment" Content="媒体库" GroupName="SearchScope"
                       Style="{StaticResource SegmentItem}" IsChecked="True"
                       Checked="OnScopeChanged" />
          <RadioButton x:Name="RecordSegment" Content="记录" GroupName="SearchScope"
                       Style="{StaticResource SegmentItem}" Margin="2,0,0,0"
                       Checked="OnScopeChanged" />
        </StackPanel>
      </Border>
      <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Margin="2,10,0,0" />
    </StackPanel>

    <!-- 空态 -->
    <StackPanel x:Name="EmptyState" Grid.Row="2" HorizontalAlignment="Center"
                VerticalAlignment="Center" Margin="0,0,0,80" MaxWidth="420">
      <TextBlock x:Name="EmptyGlyph" Text="&#xE721;" Style="{StaticResource EmptyIcon}" />
      <TextBlock x:Name="EmptyTitle" Text="搜索「所有媒体库」中的内容"
                 Style="{StaticResource EmptyText}" FontSize="14" />
      <TextBlock x:Name="EmptyHint" Text="输入片名、剧名或关键词"
                 Style="{StaticResource EmptyText}" FontSize="12.5" Margin="0,6,0,0"
                 Foreground="{StaticResource FaintBrush}" />
    </StackPanel>

    <!-- 结果 -->
    <ScrollViewer x:Name="ResultScroll" Grid.Row="2" VerticalScrollBarVisibility="Hidden"
                  Margin="0,18,0,0" Visibility="Collapsed">
      <StackPanel Margin="0,0,0,28">
        <controls:PosterGrid x:Name="ResultGrid">
          <controls:PosterGrid.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,22"
                        Width="{Binding CardSlot, RelativeSource={RelativeSource AncestorType=controls:PosterGrid}}">
                <Border CornerRadius="10" Background="{Binding Background}" SnapsToDevicePixels="True"
                        Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=controls:PosterGrid}}"
                        Height="{Binding CardHeight, RelativeSource={RelativeSource AncestorType=controls:PosterGrid}}"
                        Tag="{Binding Id}" Cursor="Hand" MouseLeftButtonUp="OnCardClick">
                  <Grid>
                    <TextBlock Text="{Binding Initial}" FontSize="38" FontWeight="SemiBold"
                               Foreground="#2AFFFFFF" HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding PlaceholderVisibility}" />
                    <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="8"
                            Background="#59000000" CornerRadius="5" Padding="6,2"
                            Visibility="{Binding BadgeVisibility}">
                      <TextBlock Text="{Binding Badge}" FontSize="11.5" Foreground="#CCFFFFFF" />
                    </Border>
                  </Grid>
                </Border>
                <TextBlock Text="{Binding Title}" FontSize="13" Margin="1,9,0,0"
                           Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=controls:PosterGrid}}"
                           Foreground="{StaticResource TextBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Sub}" FontSize="12"
                           Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=controls:PosterGrid}}"
                           Foreground="{StaticResource FaintBrush}"
                           Margin="1,2,0,0" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </controls:PosterGrid.ItemTemplate>
        </controls:PosterGrid>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>