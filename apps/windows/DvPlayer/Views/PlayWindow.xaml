<Window x:Class="DvPlayer.Views.PlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:player="clr-namespace:DvPlayer.Player"
        Title="DV Player"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="Black"
        Cursor="Arrow"
        KeyDown="OnKeyDown"
        MouseMove="OnMouseMove">

  <Grid x:Name="Root" Background="Black">
    <player:MpvHost x:Name="Host" />

    <!-- 打开中 -->
    <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock x:Name="LoadingTitle" Text="" FontFamily="{StaticResource DisplayFont}"
                 FontSize="22" Foreground="#E6FFFFFF" TextAlignment="Center"
                 TextWrapping="Wrap" MaxWidth="720" />
      <TextBlock x:Name="LoadingStatus" Text="正在打开…" FontSize="13.5"
                 Foreground="#99FFFFFF" Margin="0,10,0,0" TextAlignment="Center" />
    </StackPanel>

    <!-- 控制条 -->
    <Border x:Name="Chrome" VerticalAlignment="Bottom" Background="#E6141419"
            Opacity="1">
      <StackPanel Margin="30,14,30,18">

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock x:Name="PositionText" Text="00:00" FontSize="12.5"
                     Foreground="#B3FFFFFF" VerticalAlignment="Center" Width="62" />

          <Slider x:Name="Seek" Grid.Column="1" Style="{StaticResource SeekBar}"
                  Margin="10,0" Minimum="0" Maximum="1" Value="0"
                  IsMoveToPointEnabled="True"
                  Thumb.DragStarted="OnSeekDragStarted"
                  Thumb.DragCompleted="OnSeekDragCompleted" />

          <TextBlock x:Name="DurationText" Grid.Column="2" Text="00:00" FontSize="12.5"
                     Foreground="#B3FFFFFF" VerticalAlignment="Center" Width="62"
                     TextAlignment="Right" />
        </Grid>

        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

            <Button x:Name="PlayPauseButton" Style="{StaticResource PlayerButton}"
                    Click="OnPlayPauseClick" ToolTip="播放 / 暂停（空格）">
              <TextBlock x:Name="PlayPauseGlyph" Text="&#xE769;" FontFamily="{StaticResource IconFont}"
                         FontSize="17" />
            </Button>

            <Button Style="{StaticResource PlayerButton}" Click="OnBack10Click"
                    Margin="2,0,0,0" ToolTip="后退 10 秒（←）">
              <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource IconFont}" FontSize="16" />
            </Button>

            <Button Style="{StaticResource PlayerButton}" Click="OnForward10Click"
                    ToolTip="前进 10 秒（→）">
              <TextBlock Text="&#xE7A8;" FontFamily="{StaticResource IconFont}" FontSize="16" />
            </Button>

            <Button x:Name="MuteButton" Style="{StaticResource PlayerButton}"
                    Click="OnMuteClick" Margin="8,0,0,0" ToolTip="静音（M）">
              <TextBlock x:Name="MuteGlyph" Text="&#xE767;" FontFamily="{StaticResource IconFont}"
                         FontSize="16" />
            </Button>

            <Slider x:Name="Volume" Width="92" Margin="6,0,0,0"
                    Minimum="0" Maximum="100" Value="100"
                    VerticalAlignment="Center"
                    ValueChanged="OnVolumeChanged"
                    Thumb.DragStarted="OnVolumeDragStarted" />
          </StackPanel>

          <TextBlock x:Name="TitleText" Grid.Column="1" Text="" FontSize="13"
                     Foreground="#99FFFFFF" VerticalAlignment="Center"
                     Margin="18,0" TextTrimming="CharacterEllipsis" />

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="TracksButton" Style="{StaticResource PlayerButton}"
                    Click="OnTracksClick" ToolTip="音轨 / 字幕">
              <TextBlock Text="&#xE8D4;" FontFamily="{StaticResource IconFont}" FontSize="16" />
            </Button>

            <Button Style="{StaticResource PlayerButton}" Click="OnCloseClick"
                    ToolTip="退出（Esc）">
              <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="16" />
            </Button>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <!-- 错误 -->
    <Border x:Name="ErrorPanel" Visibility="Collapsed" MaxWidth="560"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="#F01F1F27" CornerRadius="14" Padding="26,22">
      <StackPanel>
        <TextBlock Text="播放失败" FontSize="16" Foreground="#FF6B6B" FontWeight="SemiBold" />
        <TextBlock x:Name="ErrorText" Margin="0,10,0,0" FontSize="13"
                   Foreground="#B3FFFFFF" TextWrapping="Wrap" />
        <Button Content="关闭" Click="OnCloseClick" Margin="0,18,0,0"
                Style="{StaticResource GhostButton}" HorizontalAlignment="Left" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
