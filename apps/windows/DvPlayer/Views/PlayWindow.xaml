<Window x:Class="DvPlayer.Views.PlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DV Player"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="Transparent"
        Cursor="Arrow"
        KeyDown="OnKeyDown"
        MouseMove="OnMouseMove">

  <!--
    这一层只有控制条：视频在下面一个独立的黑窗里（PlayerSurfaceWindow）。
    WPF 的 HwndHost 总是盖住同窗口的 WPF 内容，所以视频和浮层必须分窗。
    底色用 #01000000 而不是 Transparent：分层窗口的 0 alpha 像素会让鼠标
    穿透到下面的视频窗，点视频就收不到事件了。
  -->
  <Grid x:Name="Root" Background="#01000000"
        MouseLeftButtonDown="OnSurfaceMouseDown"
        MouseLeftButtonUp="OnSurfaceMouseUp"
        MouseWheel="OnSurfaceWheel">

    <!-- 打开中 / 切集：整窗一层不透明黑。
         浮层本身是透明的，视频窗还没出画面时下面就是桌面，看着像「透明窗口」。
         就绪后这层淡出（FinishOpening），控制条那时候才淡入。 -->
    <Border x:Name="OpeningCover" Background="#FF000000">
      <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- 转圈：慢网络下要让人看出「还在动」，不是卡死的黑窗 -->
        <Grid x:Name="LoadingSpinner" Width="30" Height="30" Margin="0,0,0,18"
              HorizontalAlignment="Center">
          <Ellipse Width="30" Height="30" Stroke="#26FFFFFF" StrokeThickness="2" />
          <Ellipse Width="30" Height="30" Stroke="#E6FFFFFF" StrokeThickness="2"
                   StrokeDashArray="12 40" StrokeDashCap="Round"
                   RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
              <RotateTransform x:Name="SpinnerRotate" />
            </Ellipse.RenderTransform>
          </Ellipse>
        </Grid>

        <TextBlock x:Name="LoadingTitle" Text="" FontFamily="{StaticResource DisplayFont}"
                   FontSize="22" Foreground="#E6FFFFFF" TextAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="720" />
        <TextBlock x:Name="LoadingStatus" Text="正在打开…" FontSize="13.5"
                   Foreground="#99FFFFFF" Margin="0,10,0,0" TextAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- 播放器浮层：跟着鼠标显隐 -->
    <Grid x:Name="Overlay" Background="Transparent">

      <!-- 顶部：片名居中，右边是缓存速度 / 静音 / 窗口按钮。整条压在画面上，不要实底 -->
      <Grid x:Name="TopBar" VerticalAlignment="Top" Height="48" Opacity="1">
        <Border x:Name="TopScrim" Height="100" VerticalAlignment="Top" IsHitTestVisible="False">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#99000000" Offset="0" />
              <GradientStop Color="#00000000" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>

        <!-- 片名 + 播放状态：盘内菜单期间收掉（那是壳的 UI，菜单自己有标题）。 -->
        <StackPanel x:Name="TopInfo" Orientation="Horizontal" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Margin="0,0,0,1">
          <TextBlock x:Name="TopTitle" VerticalAlignment="Center"
                     FontSize="14" FontWeight="SemiBold"
                     Foreground="#F2FFFFFF" TextTrimming="CharacterEllipsis" MaxWidth="560" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,12,0">
          <!-- 缓存速度 / 静音：和片名一样，菜单期间收掉。 -->
          <StackPanel x:Name="TopStatus" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="SpeedText" FontSize="12" Foreground="#D9FFFFFF"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock x:Name="TopMuteGlyph" Text="&#xE74F;" FontFamily="{StaticResource IconFont}"
                       FontSize="14" Foreground="#E6FFFFFF" VerticalAlignment="Center"
                       Margin="0,0,10,0" Visibility="Collapsed" />
          </StackPanel>

          <Button x:Name="MinimizeButton" Style="{StaticResource PlayerCaptionButton}"
                  Click="OnMinimizeClick" ToolTip="最小化">
            <TextBlock Text="&#xE921;" FontFamily="{StaticResource IconFont}" FontSize="12"
                       Foreground="#F2FFFFFF" />
          </Button>
          <Button x:Name="MaximizeButton" Style="{StaticResource PlayerCaptionButton}"
                  Click="OnMaximizeClick" ToolTip="最大化">
            <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="{StaticResource IconFont}"
                       FontSize="12" Foreground="#F2FFFFFF" />
          </Button>
          <Button x:Name="CloseCaptionButton" Style="{StaticResource PlayerCloseButton}"
                  Click="OnCloseClick" ToolTip="关闭（Esc）">
            <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="12"
                       Foreground="#F2FFFFFF" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- 右侧中部：截图 / 选集 -->
      <StackPanel x:Name="RightActions" HorizontalAlignment="Right" VerticalAlignment="Center"
                  Margin="0,0,18,0" Opacity="1">
        <Button x:Name="ShotButton" Style="{StaticResource PlayerCircleButton}"
                Click="OnShotClick" ToolTip="截图">
          <TextBlock Text="&#xE722;" FontFamily="{StaticResource IconFont}" FontSize="18"
                     Foreground="#E6FFFFFF">
            <TextBlock.Effect>
              <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="0" Opacity="0.7" />
            </TextBlock.Effect>
          </TextBlock>
        </Button>
        <Button x:Name="EpisodesButton" Style="{StaticResource PlayerCircleButton}"
                Click="OnEpisodesClick" ToolTip="选集"
                Margin="0,8,0,0" Visibility="Collapsed">
          <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="18"
                     Foreground="#E6FFFFFF">
            <TextBlock.Effect>
              <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="0" Opacity="0.7" />
            </TextBlock.Effect>
          </TextBlock>
        </Button>
      </StackPanel>

      <!-- 选集面板（右侧中部弹出） -->
      <Border x:Name="EpisodePanel" HorizontalAlignment="Right" VerticalAlignment="Center"
              Width="380" MaxHeight="580" Margin="0,0,74,0" Visibility="Collapsed"
              Background="#F2141419" BorderBrush="#26FFFFFF" BorderThickness="1"
              CornerRadius="14" Padding="8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Grid Margin="8,4,8,8">
            <TextBlock x:Name="EpisodePanelTitle" Text="选集" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" />
            <TextBlock x:Name="EpisodePanelMeta" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Style="{StaticResource Caption}" />
          </Grid>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="EpisodeList" Margin="0,0,6,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border x:Name="RowBorder" Margin="0,0,0,6" CornerRadius="10" Padding="6"
                          Background="Transparent" Cursor="Hand"
                          Tag="{Binding Id}" MouseLeftButtonUp="OnEpisodePick">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>

                      <Border Width="{Binding ThumbWidth}" Height="{Binding ThumbHeight}"
                              CornerRadius="7"
                              Background="{Binding Background}" SnapsToDevicePixels="True">
                        <Grid ClipToBounds="True">
                          <TextBlock Text="{Binding Initial}" FontSize="22" FontWeight="SemiBold"
                                     Foreground="#2AFFFFFF" HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Visibility="{Binding PlaceholderVisibility}" />
                        </Grid>
                      </Border>

                      <Border x:Name="ActiveRing" Grid.ColumnSpan="2" Margin="-2" CornerRadius="9"
                              BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                              Visibility="{Binding SelectedVisibility}" />

                      <StackPanel Grid.Column="1" Margin="12,0,4,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Badge}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Meta}" FontSize="12.5" Margin="0,5,0,0"
                                   Foreground="{StaticResource FaintBrush}"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Grid>
                  </Border>
                  <DataTemplate.Triggers>
                    <Trigger SourceName="RowBorder" Property="IsMouseOver" Value="True">
                      <Setter TargetName="RowBorder" Property="Background" Value="#1AFFFFFF" />
                    </Trigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- 媒体信息（「更多」里打开） -->
      <Border x:Name="MediaInfoPanel" HorizontalAlignment="Right" VerticalAlignment="Center"
              Width="380" MaxHeight="520" Margin="0,0,74,0" Visibility="Collapsed"
              Background="#F2141419" BorderBrush="#26FFFFFF" BorderThickness="1"
              CornerRadius="14" Padding="18,14">
        <StackPanel>
          <Grid Margin="0,0,0,10">
            <TextBlock Text="媒体信息" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" />
            <Button Click="OnCloseMediaInfoClick" Style="{StaticResource PlayerButton}"
                    Width="30" Height="30" HorizontalAlignment="Right" ToolTip="关闭">
              <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="13"
                         Foreground="#B3FFFFFF" />
            </Button>
          </Grid>
          <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="440">
            <TextBlock x:Name="MediaInfoText" FontSize="12.5" Foreground="#C2FFFFFF"
                       TextWrapping="Wrap" LineHeight="21" />
          </ScrollViewer>
        </StackPanel>
      </Border>

      <TextBlock x:Name="ToastText" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                 Margin="0,0,0,132" FontSize="13.5" Foreground="#F2FFFFFF"
                 Background="#B3000000" Padding="14,7" Visibility="Collapsed" />

      <!-- 片尾区间到了浮出来；不自动跳，给用户自己决定（和 macOS 一致） -->
      <Button x:Name="SkipOutroButton" Style="{StaticResource GhostButton}"
              HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Margin="0,0,24,118" Padding="14,8" Visibility="Collapsed"
              Background="#9E000000" Click="OnSkipOutroClick" ToolTip="直接接下一集">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE893;" FontFamily="{StaticResource IconFont}" FontSize="11"
                     Foreground="#F2FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0" />
          <TextBlock Text="跳过片尾" FontSize="12.5" Foreground="#F2FFFFFF"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <!-- 底部控制条 -->
      <Grid x:Name="Chrome" VerticalAlignment="Bottom" Opacity="1">
        <Border Height="230" VerticalAlignment="Bottom" IsHitTestVisible="False">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#00000000" Offset="0" />
              <GradientStop Color="#80000000" Offset="0.55" />
              <GradientStop Color="#E6000000" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>

        <StackPanel x:Name="ChromeStack" Margin="24,0,24,18" VerticalAlignment="Bottom">

          <!-- 规格标签：HW / HEVC / HDR / 2160p / 23FPS / 70mbps -->
          <WrapPanel x:Name="ChipsRow" Margin="0,0,0,10" />

          <Grid x:Name="WideControls">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="PrevButton" Style="{StaticResource PlayerButton}"
                    Click="OnPrevEpisodeClick" ToolTip="上一集（PageUp）" VerticalAlignment="Center">
              <TextBlock Text="&#xE892;" FontFamily="{StaticResource IconFont}" FontSize="17"
                         Foreground="#F2FFFFFF" />
            </Button>

            <Button x:Name="PlayPauseButton" Grid.Column="1" Style="{StaticResource PlayerButton}"
                    Click="OnPlayPauseClick" ToolTip="播放 / 暂停（空格）" VerticalAlignment="Center">
              <TextBlock x:Name="PlayPauseGlyph" Text="&#xE769;" FontFamily="{StaticResource IconFont}"
                         FontSize="20" Foreground="#F2FFFFFF" />
            </Button>

            <Button x:Name="NextButton" Grid.Column="2" Style="{StaticResource PlayerButton}"
                    Click="OnNextEpisodeClick" ToolTip="下一集（PageDown）" VerticalAlignment="Center">
              <TextBlock Text="&#xE893;" FontFamily="{StaticResource IconFont}" FontSize="17"
                         Foreground="#F2FFFFFF" />
            </Button>

            <TextBlock x:Name="PositionText" Grid.Column="3" Text="00:00" FontSize="12.5"
                       Foreground="#E6FFFFFF" VerticalAlignment="Center" Width="58"
                       Margin="6,0,0,0" />

            <Grid x:Name="SeekHost" Grid.Column="4" Margin="8,0" Height="18"
                  VerticalAlignment="Center">
              <!-- 未观看 / 已缓冲 / 已观看三层，颜色和宽度由 UpdateSeekBars 维护 -->
              <Border x:Name="SeekTrackBar" Height="4" CornerRadius="2"
                      Background="#3DFFFFFF" VerticalAlignment="Center"
                      IsHitTestVisible="False" />
              <Border x:Name="SeekBufferedBar" Height="4" CornerRadius="2"
                      Background="#A6FFFFFF" HorizontalAlignment="Left"
                      VerticalAlignment="Center" Width="0" IsHitTestVisible="False" />
              <Border x:Name="SeekPlayedBar" Height="4" CornerRadius="2"
                      Background="{StaticResource AccentBrush}" HorizontalAlignment="Left"
                      VerticalAlignment="Center" Width="0" IsHitTestVisible="False" />

              <Slider x:Name="Seek" Style="{StaticResource SeekBarHit}"
                      Minimum="0" Maximum="1" Value="0"
                      IsMoveToPointEnabled="True" VerticalAlignment="Stretch"
                      Thumb.DragStarted="OnSeekDragStarted"
                      Thumb.DragCompleted="OnSeekDragCompleted" />
            </Grid>

            <TextBlock x:Name="DurationText" Grid.Column="5" Text="00:00" FontSize="12.5"
                       Foreground="#B3FFFFFF" VerticalAlignment="Center" Width="66"
                       Margin="6,0,10,0" />

            <Button x:Name="MuteButton" Grid.Column="6" Style="{StaticResource PlayerButton}"
                    Click="OnMuteClick" ToolTip="静音（M）" VerticalAlignment="Center">
              <TextBlock x:Name="MuteGlyph" Text="&#xE767;" FontFamily="{StaticResource IconFont}"
                         FontSize="16" Foreground="#F2FFFFFF" />
            </Button>

            <Slider x:Name="Volume" Grid.Column="7" Width="86" Margin="2,0,10,0"
                    Style="{StaticResource VolumeBar}"
                    Minimum="0" Maximum="100" Value="100" VerticalAlignment="Center"
                    IsMoveToPointEnabled="True"
                    ValueChanged="OnVolumeChanged"
                    Thumb.DragStarted="OnVolumeDragStarted"
                    Thumb.DragCompleted="OnVolumeDragCompleted" />

            <Button x:Name="AudioButton" Grid.Column="8" Style="{StaticResource PlayerButton}"
                    Click="OnAudioClick" ToolTip="音轨" VerticalAlignment="Center">
              <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="17"
                         Foreground="#F2FFFFFF" />
            </Button>

            <Button x:Name="SubtitleButton" Grid.Column="9" Style="{StaticResource PlayerButton}"
                    Click="OnSubtitleClick" ToolTip="字幕" VerticalAlignment="Center">
              <Viewbox Width="20" Height="18">
                <Canvas Width="20" Height="18">
                  <Rectangle Canvas.Left="1" Canvas.Top="2" Width="18" Height="14"
                             RadiusX="3.5" RadiusY="3.5" Stroke="#F2FFFFFF" StrokeThickness="1.6" />
                  <Rectangle Canvas.Left="4.2" Canvas.Top="10" Width="6.4" Height="3.2"
                             RadiusX="1.2" RadiusY="1.2" Fill="#F2FFFFFF" />
                  <Rectangle Canvas.Left="12.4" Canvas.Top="10" Width="3.4" Height="3.2"
                             RadiusX="1.2" RadiusY="1.2" Fill="#F2FFFFFF" />
                </Canvas>
              </Viewbox>
            </Button>

            <!-- 弹幕开关：放在字幕后面，点一下就切，不用翻「更多」。 -->
            <Button x:Name="DanmakuButton" Grid.Column="10" Style="{StaticResource PlayerButton}"
                    Click="OnDanmakuClick" ToolTip="弹幕" VerticalAlignment="Center">
              <TextBlock x:Name="DanmakuGlyph" Text="弹" FontSize="13.5" FontWeight="SemiBold"
                         Foreground="#F2FFFFFF" />
            </Button>

            <Button x:Name="SpeedButton" Grid.Column="11" Style="{StaticResource PlayerButton}"
                    Click="OnSpeedClick" ToolTip="播放速度" VerticalAlignment="Center">
              <TextBlock x:Name="SpeedGlyph" Text="1.0×" FontSize="12.5" FontWeight="SemiBold"
                         Foreground="#F2FFFFFF" />
            </Button>

            <Button x:Name="FullscreenButton" Grid.Column="12" Style="{StaticResource PlayerButton}"
                    Click="OnFullscreenClick" ToolTip="全屏（F11 / 双击画面）" VerticalAlignment="Center">
              <TextBlock x:Name="FullscreenGlyph" Text="&#xE740;" FontFamily="{StaticResource IconFont}"
                         FontSize="16" Foreground="#F2FFFFFF" />
            </Button>

            <Button x:Name="MoreButton" Grid.Column="13" Style="{StaticResource PlayerButton}"
                    Click="OnMoreClick" ToolTip="更多" VerticalAlignment="Center">
              <TextBlock Text="&#xE712;" FontFamily="{StaticResource IconFont}" FontSize="17"
                         Foreground="#F2FFFFFF" />
            </Button>
          </Grid>
        </StackPanel>
      </Grid>
    </Grid>

    <!-- 播放中缓冲：只在已经出画后显示，浮在画面上，不盖黑整窗 -->
    <Border x:Name="BufferingPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="#CC101014" BorderBrush="#22FFFFFF" BorderThickness="1"
            CornerRadius="18" Padding="18,11" Visibility="Collapsed" Opacity="0"
            IsHitTestVisible="False">
      <StackPanel Orientation="Horizontal">
        <Grid Width="18" Height="18" VerticalAlignment="Center">
          <Ellipse Width="18" Height="18" Stroke="#33FFFFFF" StrokeThickness="2" />
          <Ellipse Width="18" Height="18" Stroke="#E6FFFFFF" StrokeThickness="2"
                   StrokeDashArray="8 24" StrokeDashCap="Round"
                   RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
              <RotateTransform x:Name="BufferingSpin" />
            </Ellipse.RenderTransform>
          </Ellipse>
        </Grid>

        <TextBlock Text="正在缓冲…" FontSize="13" Foreground="#E6FFFFFF"
                   VerticalAlignment="Center" Margin="10,0,0,0" />
      </StackPanel>
    </Border>

    <!-- 错误 -->
    <Border x:Name="ErrorPanel" Visibility="Collapsed" MaxWidth="560"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="#F01F1F27" CornerRadius="14" Padding="26,22">
      <StackPanel>
        <TextBlock Text="播放失败" FontSize="16" Foreground="#FF6B6B" FontWeight="SemiBold" />
        <TextBlock x:Name="ErrorText" Margin="0,10,0,0" FontSize="13"
                   Foreground="#B3FFFFFF" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
          <Button x:Name="ErrorRetryButton" Content="重试" Click="OnErrorRetryClick"
                  Style="{StaticResource AccentButton}" />
          <Button Content="关闭" Click="OnCloseClick" Margin="10,0,0,0"
                  Style="{StaticResource GhostButton}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
