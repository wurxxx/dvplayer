<Page x:Class="DvPlayer.Views.DailyDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BgBrush}">

  <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Hidden">
    <StackPanel>

      <!--
        顶部大图 + 信息：和媒体详情页（SeriesPage）一套结构。
        豆瓣只给竖版海报，就拿海报放大模糊当背景；TMDB 有横版图就用横版图。
      -->
      <Grid x:Name="HeroRoot" MinHeight="470" ClipToBounds="True">
        <Border x:Name="BackdropBrush" Background="{DynamicResource SurfaceBrush}" />

        <Border x:Name="BackdropBlur" Opacity="0.42" Visibility="Collapsed">
          <Border.Effect>
            <BlurEffect Radius="56" KernelType="Gaussian" />
          </Border.Effect>
        </Border>

        <!-- 压暗：顶部给返回键，下半部给白字，底边淡到页面底色（见 HeroScrimBrush） -->
        <Border IsHitTestVisible="False" Background="{DynamicResource HeroInkVeilBrush}" />
        <Border IsHitTestVisible="False" Background="{DynamicResource HeroScrimBrush}" />
        <Border IsHitTestVisible="False" Background="{DynamicResource HeroSideScrimBrush}" />

        <Button x:Name="BackButton" Click="OnBackClick" Style="{StaticResource HeroBackButton}"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,16,0,0"
                ToolTip="返回（Esc）">
          <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}"
                     FontSize="16" Foreground="#E6FFFFFF" />
        </Button>

        <Grid VerticalAlignment="Bottom" Margin="40,120,40,26">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- 豆瓣只给竖版海报：左边放一张清楚的，别让整页只有一块模糊的底 -->
          <Border x:Name="PosterCard" Width="178" Height="267" CornerRadius="10"
                  Margin="0,0,26,0" VerticalAlignment="Bottom" Visibility="Collapsed"
                  Background="{DynamicResource SurfaceBrush}" ClipToBounds="True">
            <Border.Effect>
              <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="6" Opacity="0.45" />
            </Border.Effect>
          </Border>

          <StackPanel Grid.Column="1" MaxWidth="860" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Border Background="{DynamicResource AccentBrush}" CornerRadius="5" Padding="7,2"
                      VerticalAlignment="Center">
                <TextBlock x:Name="SourceText" Text="豆瓣" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource OnAccentBrush}" />
              </Border>
              <TextBlock x:Name="LoadingText" Text="正在读取资料…" Style="{StaticResource Caption}"
                         Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="TitleText" FontFamily="{StaticResource DisplayFont}"
                       FontSize="31" FontWeight="SemiBold" Foreground="#FFFFFFFF"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="OriginalTitleText" FontSize="13" Foreground="#E6FFFFFF"
                       Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <TextBlock x:Name="RatingText" FontSize="14.5" FontWeight="SemiBold"
                         Foreground="#FFFFFFFF" VerticalAlignment="Center"
                         Margin="0,0,16,0" Visibility="Collapsed" />
              <TextBlock x:Name="MetaText" FontSize="13.5" Foreground="#E6FFFFFF"
                         VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel x:Name="TagBar" Orientation="Horizontal" Margin="0,11,0,0" />

            <WrapPanel Margin="0,20,0,0">
              <Button x:Name="SubscribeButton" Style="{StaticResource HeroPlayButton}"
                      Click="OnSubscribeClick">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="SubscribeGlyph" Text="&#xE710;"
                             FontFamily="{StaticResource IconFont}" FontSize="14"
                             VerticalAlignment="Center" />
                  <TextBlock x:Name="SubscribeButtonText" Text="添加订阅" FontSize="14"
                             FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <Button x:Name="DoubanButton" Style="{StaticResource HeroActionButton}"
                      Click="OnDoubanClick" ToolTip="在浏览器打开豆瓣条目页">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="14"
                             VerticalAlignment="Center" />
                  <TextBlock Text="豆瓣" FontSize="13.5" Margin="8,0,0,0"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <Button x:Name="TmdbButton" Style="{StaticResource HeroActionButton}"
                      Click="OnTmdbClick" ToolTip="在浏览器打开 TMDB 条目页">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="14"
                             VerticalAlignment="Center" />
                  <TextBlock Text="TMDB" FontSize="13.5" Margin="8,0,0,0"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <Button x:Name="ImdbButton" Style="{StaticResource HeroActionButton}"
                      Click="OnImdbClick" ToolTip="在浏览器打开 IMDb 条目页">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="14"
                             VerticalAlignment="Center" />
                  <TextBlock Text="IMDb" FontSize="13.5" Margin="8,0,0,0"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </WrapPanel>

            <TextBlock x:Name="NoticeText" FontSize="12" Foreground="#E6FFFFFF"
                       TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed" />
          </StackPanel>
        </Grid>
      </Grid>

      <StackPanel Margin="40,10,40,44">
        <!-- 简介全文 -->
        <StackPanel x:Name="IntroSection" Visibility="Collapsed" Margin="0,28,0,0">
          <TextBlock Text="简介" Style="{StaticResource SectionTitle}" FontSize="16" />
          <TextBlock x:Name="IntroText" FontSize="13.5" Foreground="{DynamicResource MutedBrush}"
                     TextWrapping="Wrap" LineHeight="23" Margin="0,10,0,0" />
        </StackPanel>

        <!-- 演职人员：导演 / 主演按行排，不摆头像（豆瓣只给名字） -->
        <StackPanel x:Name="PeopleSection" Visibility="Collapsed" Margin="0,16,0,0">
          <TextBlock Text="演职人员" Style="{StaticResource SectionTitle}" FontSize="16" />
          <StackPanel x:Name="PeopleList" Margin="0,10,0,0" />
        </StackPanel>

        <!-- 订阅说明 -->
        <StackPanel Margin="0,28,0,0">
          <TextBlock Text="订阅" Style="{StaticResource SectionTitle}" FontSize="16" />
          <TextBlock x:Name="SubscribeHintText" FontSize="12.5"
                     Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap"
                     Margin="0,10,0,0" LineHeight="20" />
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
