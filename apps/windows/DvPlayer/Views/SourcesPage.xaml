<Page x:Class="DvPlayer.Views.SourcesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgBrush}">

  <Grid Margin="32,40,32,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 统一工具条：标题 + 刷新 + 添加 -->
    <Grid Height="52" Margin="0,0,0,14">
      <TextBlock Text="服务器" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="ReconnectButton" Style="{StaticResource ToolButton}"
                Click="OnReconnectClick" ToolTip="重新连接全部">
          <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="15" />
        </Button>
        <Button Content="添加服务器" Style="{StaticResource AccentButton}"
                Click="OnAddToggleClick" Margin="8,0,0,0" Padding="14,7" FontSize="13" />
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
      <StackPanel Margin="0,0,0,28">
        <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" TextWrapping="Wrap" />

        <ItemsControl x:Name="SourceGrid" Margin="0,14,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="320" Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                      Padding="16" Margin="0,0,16,16">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="42" Height="42" CornerRadius="11" Background="#1FFFFFFF">
                      <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}"
                                 FontSize="17" Foreground="{StaticResource MutedBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" FontSize="14" Margin="7,0,0,0"
                                   Foreground="{StaticResource TextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Text="{Binding KindLabel}" FontSize="12.5"
                                 Foreground="{StaticResource FaintBrush}" Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                      <Button Style="{StaticResource ToolButton}" Tag="{Binding Id}"
                              Click="OnEditClick" ToolTip="编辑这个源">
                        <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}"
                                   FontSize="12.5" />
                      </Button>
                      <Button Style="{StaticResource ToolButton}" Tag="{Binding Id}"
                              Click="OnRemoveClick" Margin="2,0,0,0" ToolTip="删除这个源">
                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}"
                                   FontSize="12.5" />
                      </Button>
                    </StackPanel>
                  </Grid>

                  <TextBlock Text="{Binding Base}" FontSize="12.5"
                             Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0"
                             TextTrimming="CharacterEllipsis" ToolTip="{Binding Base}" />

                  <TextBlock Text="{Binding StatusText}" FontSize="12"
                             Foreground="{Binding StatusBrush}" Margin="0,6,0,0"
                             TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                             MaxHeight="32" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 空态：没有源时给一个明确的入口 -->
        <StackPanel x:Name="EmptyState" Margin="0,60,0,0" Visibility="Collapsed">
          <TextBlock Text="&#xE774;" Style="{StaticResource EmptyIcon}" />
          <TextBlock Text="还没有服务器" Style="{StaticResource EmptyText}" />
          <TextBlock Text="支持飞牛影视、Emby 与 Jellyfin" Style="{StaticResource EmptyText}"
                     FontSize="12.5" Margin="0,6,0,0" Foreground="{StaticResource FaintBrush}" />
        </StackPanel>

        <!-- 添加表单：从工具条的「添加媒体源」展开 -->
        <Border x:Name="AddPanel" Style="{StaticResource PanelCard}" Width="480"
                HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,4,0,0">
          <StackPanel>
            <TextBlock x:Name="AddTitle" Text="添加服务器" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Emby / Jellyfin 用账号密码登录，也可以只填 API Key（用户名留空）。"
                       Style="{StaticResource Caption}" Margin="0,5,0,0" TextWrapping="Wrap" />

            <TextBlock Text="类型" Style="{StaticResource FieldLabel}" />
            <!-- 类型只有三种，用分段按钮比下拉框更贴合这套深色界面 -->
            <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left"
                    Background="{StaticResource SurfaceHoverBrush}">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="KindFnos" Content="飞牛影视" GroupName="Kind"
                             Style="{StaticResource SegmentItem}" IsChecked="True" />
                <RadioButton x:Name="KindEmby" Content="Emby" GroupName="Kind"
                             Style="{StaticResource SegmentItem}" Margin="2,0,0,0" />
                <RadioButton x:Name="KindJellyfin" Content="Jellyfin" GroupName="Kind"
                             Style="{StaticResource SegmentItem}" Margin="2,0,0,0" />
              </StackPanel>
            </Border>

            <TextBlock Text="名称" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="NameBox" Text="飞牛影视" Style="{StaticResource Input}" />

            <TextBlock Text="服务器地址" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="BaseBox" Text="http://10.0.0.134:8005" Style="{StaticResource Input}" />

            <TextBlock Text="用户名（Emby 可留空）" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="UserBox" Style="{StaticResource Input}" />

            <TextBlock Text="密码 / API Key" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="PassBox" Style="{StaticResource InputPassword}" />

            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
              <Button x:Name="AddSubmitButton" Content="添加并连接" Click="OnAddClick"
                      Style="{StaticResource AccentButton}" />
              <Button Content="取消" Click="OnAddToggleClick" Margin="10,0,0,0"
                      Style="{StaticResource GhostButton}" />
            </StackPanel>

            <TextBlock x:Name="AddStatus" Style="{StaticResource Caption}" Margin="0,12,0,0"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>