<Page x:Class="DvPlayer.Views.RecordsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgBrush}">

  <Grid Margin="36,30,36,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="播放记录" Style="{StaticResource PageTitle}" />
      <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Margin="0,6,0,0" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
      <ItemsControl x:Name="RecordList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                    Padding="12" Margin="0,0,0,8" Width="720"
                    HorizontalAlignment="Left" Tag="{Binding ItemId}"
                    Cursor="Hand" MouseLeftButtonUp="OnCardClick">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 占位缩略图（海报未接入） -->
                <Border Grid.Column="0" Width="96" Height="54" CornerRadius="7"
                        Background="{Binding Background}" Margin="0,0,14,0">
                  <TextBlock Text="{Binding Initial}" FontSize="20" FontWeight="SemiBold"
                             Foreground="#30FFFFFF" HorizontalAlignment="Center"
                             Visibility="{Binding PlaceholderVisibility}"
                             VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontSize="14"
                             Foreground="{StaticResource TextBrush}"
                             TextTrimming="CharacterEllipsis" />
                  <Grid Margin="0,8,0,0" Width="320" HorizontalAlignment="Left">
                    <Border Height="3" CornerRadius="2" Background="#26FFFFFF" VerticalAlignment="Center" />
                    <Border Height="3" CornerRadius="2" Background="{StaticResource AccentBrush}"
                            HorizontalAlignment="Left" Width="{Binding BarWidth}" VerticalAlignment="Center" />
                  </Grid>
                  <TextBlock Text="{Binding Progress}" FontSize="11.5"
                             Foreground="{StaticResource FaintBrush}" Margin="0,7,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding Remaining}" FontSize="12"
                             Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
                  <TextBlock Text="{Binding LastPlayed}" FontSize="11"
                             Foreground="{StaticResource FaintBrush}" Margin="0,4,0,0"
                             HorizontalAlignment="Right" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</Page>
