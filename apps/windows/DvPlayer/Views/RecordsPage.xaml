<Page x:Class="DvPlayer.Views.RecordsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#111114">

  <Grid Margin="40,32">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="播放记录" FontSize="28" FontWeight="SemiBold" Foreground="White" />
      <TextBlock x:Name="StatusText" Foreground="#8A8A93" Margin="0,8,0,0" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
      <ItemsControl x:Name="RecordList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="#1B1B20" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="1" Text="{Binding Progress}" Foreground="#9A9AA3"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Column="2" Text="{Binding LastPlayed}" Foreground="#6F6F78"
                           FontSize="12" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</Page>
