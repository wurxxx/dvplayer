<Page x:Class="DvPlayer.Views.RecordsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:DvPlayer.Controls"
      Background="{StaticResource BgBrush}">

  <Grid Margin="32,40,32,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 统一工具条：标题 + 分段（通用 / 观看 / 收藏） -->
    <Grid Height="52">
      <TextBlock Text="记录" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />

      <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Right"
              VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="GeneralSegment" Content="通用" GroupName="RecordTab"
                       Style="{StaticResource SegmentItem}" IsChecked="True"
                       Checked="OnTabChanged" />
          <RadioButton x:Name="WatchSegment" Content="观看" GroupName="RecordTab"
                       Style="{StaticResource SegmentItem}" Margin="2,0,0,0"
                       Checked="OnTabChanged" />
          <RadioButton x:Name="FavoriteSegment" Content="收藏" GroupName="RecordTab"
                       Style="{StaticResource SegmentItem}" Margin="2,0,0,0"
                       Checked="OnTabChanged" />
        </StackPanel>
      </Border>
    </Grid>

    <TextBlock x:Name="StatusText" Grid.Row="1" Style="{StaticResource Caption}"
               Margin="0,4,0,10" TextWrapping="Wrap" />

    <!-- 通用：继续观看 + 收藏入口 -->
    <ScrollViewer x:Name="GeneralPanel" Grid.Row="2" VerticalScrollBarVisibility="Hidden">
      <StackPanel Margin="0,8,0,28">
        <!-- 按媒体源分栏：每源一行，左右箭头滚动 -->
        <ItemsControl x:Name="ContinueGroups" Margin="0,14,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" Margin="2,0,0,9">
                  <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}"
                           VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Title}" FontSize="14"
                             Foreground="{StaticResource TextBrush}" Margin="8,0,0,0" />
                  <TextBlock Text="{Binding CountText}" FontSize="12"
                             Foreground="{StaticResource FaintBrush}" Margin="10,0,0,0"
                             VerticalAlignment="Center" />
                </StackPanel>

                <Grid>
                  <controls:HorizontalRow x:Name="RowScroll">
                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Width="248" Margin="0,0,14,4">
                            <Border Height="140" CornerRadius="10" Background="{Binding Background}"
                                    SnapsToDevicePixels="True" Tag="{Binding ItemId}"
                                    Cursor="Hand" MouseLeftButtonUp="OnCardClick">
                            <Border.ContextMenu>
                              <ContextMenu Style="{StaticResource DarkContextMenu}">
                                <MenuItem Style="{StaticResource DarkMenuItem}" Header="播放"
                                          Click="OnMenuPlay">
                                  <MenuItem.Icon>
                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}"
                                               FontSize="13" Foreground="{StaticResource MutedBrush}" />
                                  </MenuItem.Icon>
                                </MenuItem>
                                <Separator Style="{StaticResource DarkMenuSeparator}" />
                                <MenuItem Style="{StaticResource DarkMenuItem}" Header="添加到收藏夹"
                                          Click="OnMenuFavorite">
                                  <MenuItem.Icon>
                                    <TextBlock Text="&#xE734;" FontFamily="{StaticResource IconFont}"
                                               FontSize="13" Foreground="{StaticResource MutedBrush}" />
                                  </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Style="{StaticResource DarkMenuItem}" Header="标记为已观看"
                                          Click="OnMenuWatched">
                                  <MenuItem.Icon>
                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}"
                                               FontSize="13" Foreground="{StaticResource MutedBrush}" />
                                  </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Style="{StaticResource DarkMenuItem}" Header="标记为未观看"
                                          Click="OnMenuUnwatched">
                                  <MenuItem.Icon>
                                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}"
                                               FontSize="13" Foreground="{StaticResource MutedBrush}" />
                                  </MenuItem.Icon>
                                </MenuItem>
                                <Separator Style="{StaticResource DarkMenuSeparator}" />
                                <MenuItem Style="{StaticResource DarkMenuItem}" Header="移除观看记录"
                                          Click="OnMenuRemoveRecord">
                                  <MenuItem.Icon>
                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}"
                                               FontSize="13" Foreground="{StaticResource MutedBrush}" />
                                  </MenuItem.Icon>
                                </MenuItem>
                              </ContextMenu>
                            </Border.ContextMenu>
                              <Grid ClipToBounds="True">
                                <TextBlock Text="{Binding Initial}" FontSize="42" FontWeight="SemiBold"
                                           Foreground="#2AFFFFFF" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding PlaceholderVisibility}" />

                                <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                        Margin="0,0,10,10" Background="#8C000000" CornerRadius="6"
                                        Padding="7,3">
                                  <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}"
                                               FontSize="10.5" Foreground="#E6FFFFFF"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Time}" FontSize="11.5" Foreground="#E6FFFFFF"
                                               Margin="4,0,0,0" />
                                  </StackPanel>
                                </Border>

                                <Border Height="3" VerticalAlignment="Bottom" Background="#33FFFFFF">
                                  <Border Background="{StaticResource AccentBrush}" HorizontalAlignment="Left"
                                          Width="{Binding BarWidth}" />
                                </Border>
                              </Grid>
                            </Border>

                            <TextBlock Text="{Binding Title}" FontSize="14" Margin="2,9,0,0"
                                       Foreground="{StaticResource TextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Sub}" FontSize="12"
                                       Foreground="{StaticResource FaintBrush}" Margin="2,3,0,0"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </controls:HorizontalRow>

                  <Button Style="{StaticResource ScrollArrow}" Content="&#xE76B;"
                          HorizontalAlignment="Left" VerticalAlignment="Top"
                          Margin="2,53,0,0"
                          Tag="{Binding ElementName=RowScroll}" Click="OnScrollLeft" />
                  <Button Style="{StaticResource ScrollArrow}" Content="&#xE76C;"
                          HorizontalAlignment="Right" VerticalAlignment="Top"
                          Margin="0,53,2,0"
                          Tag="{Binding ElementName=RowScroll}" Click="OnScrollRight" />
                </Grid>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="ContinueEmpty" Text="还没有看到一半的内容。"
                   Style="{StaticResource Caption}" Margin="0,10,0,0" Visibility="Collapsed" />

        <TextBlock Text="视频收藏" Style="{StaticResource SectionTitle}" FontSize="15"
                   Margin="0,30,0,0" />
        <TextBlock Text="还没有收藏的视频。在海报上点右键就能收藏。"
                   Style="{StaticResource Caption}" Margin="0,8,0,0" />
      </StackPanel>
    </ScrollViewer>

    <!-- 观看：全部记录，横向卡片行 -->
    <ScrollViewer x:Name="WatchPanel" Grid.Row="2" VerticalScrollBarVisibility="Hidden"
                  Visibility="Collapsed">
      <ItemsControl x:Name="WatchList" Margin="0,8,0,28">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Width="248" Margin="0,0,14,22">
              <Border Height="140" CornerRadius="10" Background="{Binding Background}"
                      SnapsToDevicePixels="True" Tag="{Binding ItemId}"
                      Cursor="Hand" MouseLeftButtonUp="OnCardClick">
              <Border.ContextMenu>
                <ContextMenu Style="{StaticResource DarkContextMenu}">
                  <MenuItem Style="{StaticResource DarkMenuItem}" Header="播放"
                            Click="OnMenuPlay">
                    <MenuItem.Icon>
                      <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}"
                                 FontSize="13" Foreground="{StaticResource MutedBrush}" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <Separator Style="{StaticResource DarkMenuSeparator}" />
                  <MenuItem Style="{StaticResource DarkMenuItem}" Header="添加到收藏夹"
                            Click="OnMenuFavorite">
                    <MenuItem.Icon>
                      <TextBlock Text="&#xE734;" FontFamily="{StaticResource IconFont}"
                                 FontSize="13" Foreground="{StaticResource MutedBrush}" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Style="{StaticResource DarkMenuItem}" Header="标记为已观看"
                            Click="OnMenuWatched">
                    <MenuItem.Icon>
                      <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}"
                                 FontSize="13" Foreground="{StaticResource MutedBrush}" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Style="{StaticResource DarkMenuItem}" Header="标记为未观看"
                            Click="OnMenuUnwatched">
                    <MenuItem.Icon>
                      <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}"
                                 FontSize="13" Foreground="{StaticResource MutedBrush}" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <Separator Style="{StaticResource DarkMenuSeparator}" />
                  <MenuItem Style="{StaticResource DarkMenuItem}" Header="移除观看记录"
                            Click="OnMenuRemoveRecord">
                    <MenuItem.Icon>
                      <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}"
                                 FontSize="13" Foreground="{StaticResource MutedBrush}" />
                    </MenuItem.Icon>
                  </MenuItem>
                </ContextMenu>
              </Border.ContextMenu>
                <Grid ClipToBounds="True">
                  <TextBlock Text="{Binding Initial}" FontSize="42" FontWeight="SemiBold"
                             Foreground="#2AFFFFFF" HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Visibility="{Binding PlaceholderVisibility}" />

                  <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                          Margin="0,0,10,10" Background="#8C000000" CornerRadius="6"
                          Padding="7,3">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}"
                                 FontSize="10.5" Foreground="#E6FFFFFF"
                                 VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Time}" FontSize="11.5" Foreground="#E6FFFFFF"
                                 Margin="4,0,0,0" />
                    </StackPanel>
                  </Border>

                  <Border Height="3" VerticalAlignment="Bottom" Background="#33FFFFFF">
                    <Border Background="{StaticResource AccentBrush}" HorizontalAlignment="Left"
                            Width="{Binding BarWidth}" />
                  </Border>
                </Grid>
              </Border>

              <TextBlock Text="{Binding Title}" FontSize="14" Margin="2,9,0,0"
                         Foreground="{StaticResource TextBrush}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Sub}" FontSize="12"
                         Foreground="{StaticResource FaintBrush}" Margin="2,3,0,0"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- 收藏：竖版海报网格 -->
    <ScrollViewer x:Name="FavoriteScroll" Grid.Row="2" VerticalScrollBarVisibility="Hidden"
                  Visibility="Collapsed">
      <controls:PosterGrid x:Name="FavoriteList" Margin="0,8,0,28">
        <controls:PosterGrid.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,0,0,22"
                        Width="{Binding CardSlot, RelativeSource={RelativeSource AncestorType=controls:PosterGrid}}">
              <Border CornerRadius="10" Background="{Binding Background}" SnapsToDevicePixels="True"
                      Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=controls:PosterGrid}}"
                      Height="{Binding CardHeight, RelativeSource={RelativeSource AncestorType=controls:PosterGrid}}"
                      Tag="{Binding Id}" Cursor="Hand" MouseLeftButtonUp="OnCardClick">
              <Border.ContextMenu>
                <ContextMenu Style="{StaticResource DarkContextMenu}">
                  <MenuItem Style="{StaticResource DarkMenuItem}" Header="取消收藏"
                            Click="OnMenuUnfavorite">
                    <MenuItem.Icon>
                      <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}"
                                 FontSize="13" Foreground="{StaticResource MutedBrush}" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Style="{StaticResource DarkMenuItem}" Header="标记为已观看"
                            Click="OnMenuWatched">
                    <MenuItem.Icon>
                      <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}"
                                 FontSize="13" Foreground="{StaticResource MutedBrush}" />
                    </MenuItem.Icon>
                  </MenuItem>
                </ContextMenu>
              </Border.ContextMenu>
                <Grid>
                  <TextBlock Text="{Binding Initial}" FontSize="38" FontWeight="SemiBold"
                             Foreground="#2AFFFFFF" HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Visibility="{Binding PlaceholderVisibility}" />
                </Grid>
              </Border>
              <TextBlock Text="{Binding Title}" FontSize="13" Margin="1,9,0,0"
                         Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=controls:PosterGrid}}"
                         Foreground="{StaticResource TextBrush}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Sub}" FontSize="12"
                         Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=controls:PosterGrid}}"
                         Foreground="{StaticResource FaintBrush}" Margin="1,2,0,0"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </controls:PosterGrid.ItemTemplate>
      </controls:PosterGrid>
    </ScrollViewer>

    <!-- 收藏：空态 -->
    <StackPanel x:Name="FavoritePanel" Grid.Row="2" HorizontalAlignment="Center"
                VerticalAlignment="Center" Margin="0,0,0,80" Visibility="Collapsed">
      <TextBlock Text="&#xE734;" Style="{StaticResource EmptyIcon}" />
      <TextBlock Text="还没有收藏" Style="{StaticResource EmptyText}" FontSize="14" />
      <TextBlock Text="收藏的视频和文件夹会集中在这里" Style="{StaticResource EmptyText}"
                 FontSize="12.5" Margin="0,6,0,0" Foreground="{StaticResource FaintBrush}" />
    </StackPanel>
  </Grid>
</Page>