<Page x:Class="DvPlayer.Views.LibrariesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgBrush}">

  <Page.Resources>

    <!-- Hero 左右箭头：悬停整张横幅才淡入 -->
    <Style x:Key="HeroArrow" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="46" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="23" Background="#66000000">
              <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource IconFont}"
                         FontSize="15" Foreground="#F2FFFFFF"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#B3000000" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 媒体库卡片（「我的媒体」）：最近入库的三张竖版海报拼成一张横卡 -->
    <DataTemplate x:Key="LibraryTemplate">
      <StackPanel Margin="0,0,16,16" Cursor="Hand">
        <Border Width="420" Height="220" CornerRadius="12" Background="{Binding Background}"
                SnapsToDevicePixels="True" Tag="{Binding Id}"
                MouseLeftButtonUp="OnLibraryClick">
          <Grid>
            <Grid.Clip>
              <RectangleGeometry Rect="0,0,420,220" RadiusX="12" RadiusY="12" />
            </Grid.Clip>

            <ItemsControl ItemsSource="{Binding Arts}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="1" Columns="{Binding ArtColumns}" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{Binding Background}" SnapsToDevicePixels="True">
                    <TextBlock Text="{Binding Initial}" FontSize="30" FontWeight="SemiBold"
                               Foreground="#2AFFFFFF" HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding PlaceholderVisibility}" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border VerticalAlignment="Bottom" Height="96" IsHitTestVisible="False">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#00000000" Offset="0" />
                  <GradientStop Color="#D9000000" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                       Foreground="#F2FFFFFF" Margin="14,0,14,13"
                       VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" />
          </Grid>
        </Border>
      </StackPanel>
    </DataTemplate>

    <!-- 横向海报（每个库一行） -->
    <DataTemplate x:Key="PosterTemplate">
      <StackPanel Width="148" Margin="0,0,14,4">
        <Border Height="222" CornerRadius="10" Background="{Binding Background}"
                SnapsToDevicePixels="True" Tag="{Binding Id}"
                Cursor="Hand" MouseLeftButtonUp="OnCardClick">
          <Grid>
            <TextBlock Text="{Binding Initial}" FontSize="38" FontWeight="SemiBold"
                       Foreground="#2AFFFFFF" HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding PlaceholderVisibility}" />
            <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="8"
                    Background="#59000000" CornerRadius="5" Padding="6,2"
                    Visibility="{Binding BadgeVisibility}">
              <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="#CCFFFFFF" />
            </Border>
          </Grid>
        </Border>
        <TextBlock Text="{Binding Title}" FontSize="12.5" Margin="1,9,0,0"
                   Foreground="{StaticResource TextBrush}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{StaticResource FaintBrush}"
                   Margin="1,2,0,0" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </DataTemplate>

    <!-- 继续观看（横版 + 进度） -->
    <DataTemplate x:Key="ContinueTemplate">
      <StackPanel Width="248" Margin="0,0,14,4">
        <Border Height="140" CornerRadius="10" Background="{Binding Background}"
                SnapsToDevicePixels="True" Tag="{Binding ItemId}"
                Cursor="Hand" MouseLeftButtonUp="OnCardClick">
          <Grid ClipToBounds="True">
            <TextBlock Text="{Binding Initial}" FontSize="42" FontWeight="SemiBold"
                       Foreground="#2AFFFFFF" HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding PlaceholderVisibility}" />
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    Margin="0,0,10,10" Background="#8C000000" CornerRadius="6" Padding="7,3">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}"
                           FontSize="9" Foreground="#E6FFFFFF" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Time}" FontSize="10" Foreground="#E6FFFFFF"
                           Margin="4,0,0,0" />
              </StackPanel>
            </Border>
            <Border Height="3" VerticalAlignment="Bottom" Background="#33FFFFFF">
              <Border Background="{StaticResource AccentBrush}" HorizontalAlignment="Left"
                      Width="{Binding BarWidth}" />
            </Border>
          </Grid>
        </Border>
        <TextBlock Text="{Binding Title}" FontSize="13.5" Margin="2,9,0,0"
                   Foreground="{StaticResource TextBrush}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{StaticResource FaintBrush}"
                   Margin="2,3,0,0" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </DataTemplate>

    <!-- 每个媒体库一行：标题 + 右侧数量 + 横向海报 + 箭头 -->
    <DataTemplate x:Key="SectionTemplate">
      <StackPanel Margin="0,0,0,24">
        <Grid Margin="0,0,0,11">
          <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" FontSize="16"
                     VerticalAlignment="Center" />

          <Button Tag="{Binding Id}" Click="OnSectionMoreClick" Cursor="Hand"
                  HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="查看全部">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,4">
                  <ContentPresenter />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavHoverBrush}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding CountLabel}" FontSize="14"
                         Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
              <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="11"
                         Foreground="{StaticResource FaintBrush}" Margin="5,0,0,0"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>

        <Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled"
                        PreviewMouseWheel="OnRowWheel">
            <ItemsControl ItemsSource="{Binding Items}"
                          ItemTemplate="{StaticResource PosterTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>

          <Button Style="{StaticResource ScrollArrow}" Content="&#xE76B;"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,94,0,0"
                  Click="OnScrollLeft" />
          <Button Style="{StaticResource ScrollArrow}" Content="&#xE76C;"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,94,2,0"
                  Click="OnScrollRight" />
        </Grid>
      </StackPanel>
    </DataTemplate>
  </Page.Resources>

  <Grid x:Name="PageRoot">

    <!-- 源首页：Hero 贴边铺满，顶栏浮在它上面 -->
    <Grid x:Name="OverviewPanel">
      <ScrollViewer x:Name="OverviewRoot" VerticalScrollBarVisibility="Hidden"
                    ScrollChanged="OnOverviewScroll">
        <StackPanel>

          <!-- Hero 轮播 -->
          <Grid x:Name="HeroCard" Height="560" Cursor="Hand"
                MouseLeftButtonUp="OnHeroClick"
                MouseEnter="OnHeroEnter" MouseLeave="OnHeroLeave">
            <Border x:Name="HeroBackdrop" Background="{StaticResource SurfaceBrush}"
                    RenderOptions.BitmapScalingMode="HighQuality" />
            <Border x:Name="HeroFade" Opacity="0"
                    RenderOptions.BitmapScalingMode="HighQuality" />

            <Border VerticalAlignment="Bottom" Height="320">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#00000000" Offset="0" />
                  <GradientStop Color="#B3000000" Offset="0.55" />
                  <GradientStop Color="#F2000000" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>

            <StackPanel VerticalAlignment="Bottom" Margin="24,0,24,56"
                        HorizontalAlignment="Center" Width="800">
              <TextBlock x:Name="HeroTitle" Text="正在读取…" FontSize="36"
                         FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold"
                         Foreground="#FAFFFFFF" TextTrimming="CharacterEllipsis"
                         HorizontalAlignment="Center" TextAlignment="Center" />
              <TextBlock x:Name="HeroMeta" FontSize="13" Foreground="#D9FFFFFF"
                         Margin="0,11,0,0" HorizontalAlignment="Center" />
              <ItemsControl x:Name="HeroChips" Margin="0,12,0,0" HorizontalAlignment="Center"
                            Visibility="Collapsed">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel HorizontalAlignment="Center" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#2EFFFFFF" CornerRadius="5" Padding="8,3" Margin="4,0">
                      <TextBlock Text="{Binding}" FontSize="11" Foreground="#E6FFFFFF" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock x:Name="HeroOverview" FontSize="13.5" Foreground="#C2FFFFFF"
                         Margin="0,13,0,0" MaxHeight="66" TextTrimming="CharacterEllipsis"
                         TextWrapping="Wrap" LineHeight="22" TextAlignment="Center" />
            </StackPanel>

            <Button x:Name="HeroPrev" Style="{StaticResource HeroArrow}" Content="&#xE76B;"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="28,0,0,0"
                    Click="OnHeroPrev" />
            <Button x:Name="HeroNext" Style="{StaticResource HeroArrow}" Content="&#xE76C;"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,28,0"
                    Click="OnHeroNext" />

            <ItemsControl x:Name="HeroDots" HorizontalAlignment="Center"
                          VerticalAlignment="Bottom" Margin="0,0,0,20">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Ellipse Width="6" Height="6" Margin="3,0" Fill="{Binding Fill}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>

          <!-- 内容区 -->
          <StackPanel Margin="32,26,32,44">

            <!-- 我的媒体 -->
            <Grid Margin="0,0,0,11">
              <TextBlock Text="我的媒体" Style="{StaticResource SectionTitle}" FontSize="16" />
              <TextBlock x:Name="LibrariesCount" Style="{StaticResource Caption}"
                         HorizontalAlignment="Right" VerticalAlignment="Bottom" />
            </Grid>
            <ItemsControl x:Name="LibraryCards" ItemTemplate="{StaticResource LibraryTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- 继续观看 -->
            <Grid Margin="0,10,0,11">
              <TextBlock Text="继续观看" Style="{StaticResource SectionTitle}" FontSize="16" />
              <TextBlock x:Name="ContinueCount" Style="{StaticResource Caption}"
                         HorizontalAlignment="Right" VerticalAlignment="Bottom" />
            </Grid>
            <Grid>
              <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                            PreviewMouseWheel="OnRowWheel">
                <ItemsControl x:Name="ContinueRow" ItemTemplate="{StaticResource ContinueTemplate}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </ScrollViewer>
              <Button Style="{StaticResource ScrollArrow}" Content="&#xE76B;"
                      HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,53,0,0"
                      Click="OnScrollLeft" />
              <Button Style="{StaticResource ScrollArrow}" Content="&#xE76C;"
                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,53,2,0"
                      Click="OnScrollRight" />
            </Grid>
            <TextBlock x:Name="ContinueEmpty" Text="还没有看到一半的内容。"
                       Style="{StaticResource Caption}" Margin="0,10,0,0" Visibility="Collapsed" />

            <!-- 每个媒体库一行 -->
            <ItemsControl x:Name="Sections" ItemTemplate="{StaticResource SectionTemplate}"
                          Margin="0,26,0,0" />

            <TextBlock x:Name="StatusText" Style="{StaticResource Caption}"
                       Margin="0,16,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

    </Grid>

    <!-- 收藏（空态） -->
    <StackPanel x:Name="FavoriteEmpty" HorizontalAlignment="Center"
                VerticalAlignment="Center" Margin="0,0,0,80" Visibility="Collapsed">
      <TextBlock Text="&#xE734;" Style="{StaticResource EmptyIcon}" />
      <TextBlock Text="还没有收藏" Style="{StaticResource EmptyText}" FontSize="13.5" />
      <TextBlock Text="收藏的影片会集中在这里" Style="{StaticResource EmptyText}"
                 FontSize="11.5" Margin="0,6,0,0" Foreground="{StaticResource FaintBrush}" />
    </StackPanel>

    <!-- 媒体库内容（原网格视图） -->
    <Grid x:Name="BrowseRoot" Margin="32,24,32,0" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Height="52">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource ToolButton}" Click="OnBackToOverview" ToolTip="返回">
            <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" FontSize="15" />
          </Button>
          <TextBlock x:Name="BrowseTitle" Text="" Style="{StaticResource PageTitle}"
                     FontSize="21" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <Border Style="{StaticResource SearchBoxBorder}" Width="280" HorizontalAlignment="Right"
                VerticalAlignment="Center">
          <Grid>
            <TextBlock Text="&#xE721;" Style="{StaticResource SearchBoxIcon}" />
            <TextBox x:Name="FilterBox" Style="{StaticResource SearchBoxInput}"
                     TextChanged="OnFilterChanged" />
            <TextBlock x:Name="FilterPlaceholder" Text="在当前库中查找"
                       Style="{StaticResource SearchBoxPlaceholder}" />
          </Grid>
        </Border>
      </Grid>

      <StackPanel Grid.Row="1" Margin="0,8,0,6">
        <StackPanel x:Name="Breadcrumb" Orientation="Horizontal" Visibility="Collapsed"
                    Margin="0,0,0,12">
          <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12,6"
                  Cursor="Hand" MouseLeftButtonUp="OnBackClick">
            <TextBlock Text="&#xE72B;  返回上层" FontFamily="{StaticResource IconFont}"
                       FontSize="12" Foreground="{StaticResource AccentBrush}" />
          </Border>
          <TextBlock x:Name="BreadcrumbText" FontSize="12.5"
                     Foreground="{StaticResource MutedBrush}"
                     VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="LibraryBar">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Tag="{Binding Id}" MouseLeftButtonUp="OnChipClick" Cursor="Hand"
                        CornerRadius="8" Padding="14,7" Margin="0,0,8,0">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                      <Setter Property="TextElement.Foreground" Value="{StaticResource MutedBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Active}" Value="True">
                          <Setter Property="Background" Value="#2E2412" />
                          <Setter Property="TextElement.Foreground" Value="{StaticResource AccentBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Text="{Binding Title}" FontSize="13" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="BrowseStatus" Style="{StaticResource Caption}"
                   Margin="0,10,0,0" TextWrapping="Wrap" />
      </StackPanel>

      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden" Margin="0,14,0,0">
        <StackPanel>
          <ItemsControl x:Name="ItemGrid">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Width="148" Margin="0,0,16,22">
                  <Border Height="222" CornerRadius="10" Background="{Binding Background}"
                          SnapsToDevicePixels="True" Tag="{Binding Id}"
                          Cursor="Hand" MouseLeftButtonUp="OnCardClick">
                    <Grid>
                      <TextBlock Text="{Binding Initial}" FontSize="38" FontWeight="SemiBold"
                                 Foreground="#2AFFFFFF" HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding PlaceholderVisibility}" />
                      <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="8"
                              Background="#59000000" CornerRadius="5" Padding="6,2"
                              Visibility="{Binding BadgeVisibility}">
                        <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="#CCFFFFFF" />
                      </Border>
                    </Grid>
                  </Border>
                  <TextBlock Text="{Binding Title}" FontSize="12.5" Margin="1,9,0,0"
                             Foreground="{StaticResource TextBrush}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{StaticResource FaintBrush}"
                             Margin="1,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button x:Name="MoreButton" Content="加载更多" Click="OnMoreClick"
                  Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                  Margin="0,0,0,28" Visibility="Collapsed" />
        </StackPanel>
      </ScrollViewer>
    </Grid>

      <!-- 顶栏浮层：源名 / 分段 / 刷新 -->
      <Border x:Name="TopBarScrim" Height="108" VerticalAlignment="Top" IsHitTestVisible="False">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#99000000" Offset="0" />
            <GradientStop Color="#00000000" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>

      <Border x:Name="TopBarEdge" Height="1" VerticalAlignment="Top" Margin="0,72,0,0"
              Background="{StaticResource LineBrush}" Visibility="Collapsed"
              IsHitTestVisible="False" />

      <Grid Height="72" x:Name="TopBar" Margin="32,0,32,0" VerticalAlignment="Top">
        <TextBlock x:Name="SourceTitle" Text="媒体库" FontSize="17" FontWeight="SemiBold"
                   Foreground="#F2FFFFFF" VerticalAlignment="Center" />

        <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="MediaSegment" Content="媒体" GroupName="LibraryTab"
                         Style="{StaticResource SegmentItem}" IsChecked="True"
                         Checked="OnTabChanged" />
            <RadioButton x:Name="SearchSegment" Content="搜索" GroupName="LibraryTab"
                         Style="{StaticResource SegmentItem}" Margin="2,0,0,0"
                         Checked="OnTabChanged" />
            <RadioButton x:Name="FavoriteSegment" Content="收藏" GroupName="LibraryTab"
                         Style="{StaticResource SegmentItem}" Margin="2,0,0,0"
                         Checked="OnTabChanged" />
          </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Style="{StaticResource ToolButton}" Click="OnRefreshClick" ToolTip="刷新">
            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="15" />
          </Button>
        </StackPanel>
      </Grid>
  </Grid>
</Page>
