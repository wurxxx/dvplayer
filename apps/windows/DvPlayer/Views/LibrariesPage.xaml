<Page x:Class="DvPlayer.Views.LibrariesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgBrush}">

  <Grid Margin="36,30,36,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="媒体库" Style="{StaticResource PageTitle}" />
      <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Margin="0,6,0,0" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden"
                  VerticalScrollBarVisibility="Disabled" Margin="0,16,0,0">
      <ItemsControl x:Name="LibraryBar">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Tag="{Binding Id}" MouseLeftButtonUp="OnChipClick" Cursor="Hand"
                    CornerRadius="8" Padding="14,7" Margin="0,0,8,0">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                  <Setter Property="TextElement.Foreground" Value="{StaticResource MutedBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Active}" Value="True">
                      <Setter Property="Background" Value="#2E2412" />
                      <Setter Property="TextElement.Foreground" Value="{StaticResource AccentBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock Text="{Binding Title}" FontSize="13" />
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
      <StackPanel>
        <ItemsControl x:Name="ItemGrid">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Width="148" Margin="0,0,16,22">
                <Border Height="222" CornerRadius="10" Background="{Binding Gradient}"
                        SnapsToDevicePixels="True">
                  <Grid>
                    <TextBlock Text="{Binding Initial}" FontSize="38" FontWeight="SemiBold"
                               Foreground="#2AFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="8"
                            Background="#59000000" CornerRadius="5" Padding="6,2"
                            Visibility="{Binding BadgeVisibility}">
                      <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="#CCFFFFFF" />
                    </Border>
                  </Grid>
                </Border>
                <TextBlock Text="{Binding Title}" FontSize="12.5" Margin="1,9,0,0"
                           Foreground="{StaticResource TextBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{StaticResource FaintBrush}"
                           Margin="1,2,0,0" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button x:Name="MoreButton" Content="加载更多" Click="OnMoreClick"
                Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                Margin="0,0,0,28" Visibility="Collapsed" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
