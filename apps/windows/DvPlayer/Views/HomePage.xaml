<Page x:Class="DvPlayer.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#111114">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="40,32">
      <TextBlock Text="继续观看" FontSize="28" FontWeight="SemiBold" Foreground="White" />
      <TextBlock x:Name="StatusText" Foreground="#8A8A93" Margin="0,8,0,0" />

      <ItemsControl x:Name="RecordList" Margin="0,24,0,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Width="280" Height="160" Margin="0,0,18,18" CornerRadius="12" Background="#1B1B20">
              <Grid Margin="18">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                           Foreground="White" TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Row="1" Text="{Binding Source}" FontSize="12"
                           Foreground="#7D7D86" VerticalAlignment="Bottom" />

                <StackPanel Grid.Row="2">
                  <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="4"
                               Foreground="#4C8DFF" Background="#2A2A31" BorderThickness="0" />
                  <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="#9A9AA3" Margin="0,8,0,0" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</Page>
