<Page x:Class="DvPlayer.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgBrush}">

  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
    <StackPanel Margin="36,30,36,40">

      <!-- 继续观看 -->
      <Grid>
        <StackPanel>
          <TextBlock Text="继续观看" Style="{StaticResource PageTitle}" />
          <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Margin="0,6,0,0" />
        </StackPanel>
        <TextBlock Text="全部记录" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   FontSize="12.5" Foreground="{StaticResource FaintBrush}" Margin="0,0,2,2" />
      </Grid>

      <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                    Margin="0,18,0,0">
        <ItemsControl x:Name="ContinueList">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Width="240" Margin="0,0,12,6">
                <Border Height="135" CornerRadius="12" Background="{Binding Gradient}"
                        SnapsToDevicePixels="True">
                  <Grid ClipToBounds="True">
                    <TextBlock Text="{Binding Initial}" FontSize="46" FontWeight="SemiBold"
                               Foreground="#2AFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <Border VerticalAlignment="Bottom" Height="34"
                            Background="#66000000">
                      <Grid Margin="12,0">
                        <TextBlock Text="{Binding Time}" FontSize="11.5" Foreground="#D9FFFFFF"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                      </Grid>
                    </Border>

                    <Border Height="3" VerticalAlignment="Bottom" Background="#33FFFFFF">
                      <Border Background="{StaticResource AccentBrush}" HorizontalAlignment="Left"
                              Width="{Binding BarWidth}" />
                    </Border>
                  </Grid>
                </Border>

                <TextBlock Text="{Binding Title}" FontSize="14" Margin="2,10,0,0"
                           Foreground="{StaticResource TextBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Sub}" Style="{StaticResource Caption}" Margin="2,3,0,0" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- 最近添加 -->
      <TextBlock Text="最近添加" Style="{StaticResource PageTitle}" FontSize="20" Margin="0,26,0,0" />
      <TextBlock x:Name="RecentStatus" Style="{StaticResource Caption}" Margin="0,6,0,0" />

      <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                    Margin="0,16,0,0">
        <ItemsControl x:Name="RecentList">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Width="132" Margin="0,0,14,6">
                <Border Height="198" CornerRadius="10" Background="{Binding Gradient}">
                  <Grid>
                    <TextBlock Text="{Binding Initial}" FontSize="34" FontWeight="SemiBold"
                               Foreground="#2AFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="8"
                            Background="#59000000" CornerRadius="5" Padding="6,2">
                      <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="#CCFFFFFF" />
                    </Border>
                  </Grid>
                </Border>
                <TextBlock Text="{Binding Title}" FontSize="12.5" Margin="1,8,0,0"
                           Foreground="{StaticResource TextBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{StaticResource FaintBrush}"
                           Margin="1,2,0,0" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

    </StackPanel>
  </ScrollViewer>
</Page>
