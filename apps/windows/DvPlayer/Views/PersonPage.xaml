<Page x:Class="DvPlayer.Views.PersonPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:DvPlayer.Controls"
      Background="{StaticResource BgBrush}">

  <ScrollViewer VerticalScrollBarVisibility="Hidden">
    <StackPanel>

      <Grid Margin="40,18,40,0">
        <Button x:Name="BackButton" Style="{StaticResource PlayerButton}"
                HorizontalAlignment="Left" Click="OnBackClick" ToolTip="返回（Esc）">
          <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}"
                     FontSize="15" Foreground="{StaticResource TextBrush}" />
        </Button>

        <TextBlock x:Name="TitleText" Margin="58,0,0,0" VerticalAlignment="Center"
                   FontFamily="{StaticResource DisplayFont}" FontSize="27"
                   FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                   TextTrimming="CharacterEllipsis" />
      </Grid>

      <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Margin="40,12,40,0" />

      <controls:PosterGrid x:Name="WorkGrid" Margin="40,18,40,40">
        <controls:PosterGrid.ItemTemplate>
          <DataTemplate>
            <StackPanel Cursor="Hand" Margin="0,0,0,22"
                        Width="{Binding CardSlot, RelativeSource={RelativeSource AncestorType=controls:PosterGrid}}"
                        Tag="{Binding Id}" MouseLeftButtonUp="OnWorkClick">
              <Border CornerRadius="10" Background="{Binding Background}" SnapsToDevicePixels="True"
                      Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=controls:PosterGrid}}"
                      Height="{Binding CardHeight, RelativeSource={RelativeSource AncestorType=controls:PosterGrid}}">
                <Grid ClipToBounds="True">
                  <TextBlock Text="{Binding Initial}" FontSize="38" FontWeight="SemiBold"
                             Foreground="#2AFFFFFF" HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Visibility="{Binding PlaceholderVisibility}" />
                </Grid>
              </Border>

              <TextBlock Text="{Binding Title}" FontSize="13" Margin="1,9,0,0"
                         Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=controls:PosterGrid}}"
                         Foreground="{StaticResource TextBrush}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Sub}" FontSize="12"
                         Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=controls:PosterGrid}}"
                         Foreground="{StaticResource FaintBrush}" Margin="1,2,0,0"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </controls:PosterGrid.ItemTemplate>
      </controls:PosterGrid>
    </StackPanel>
  </ScrollViewer>
</Page>
