<Window x:Class="DvPlayer.Views.DiscMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DV Player"
        Width="980" Height="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}"
        Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display"
        PreviewMouseLeftButtonDown="OnWindowMouseDown">

  <!-- 原盘菜单：和确认框同一套深色圆角卡片，只是内容多一列章节。 -->
  <Grid Margin="24">
    <Border Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1"
            CornerRadius="16">
      <Border.Effect>
        <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.55" Color="#000000" />
      </Border.Effect>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="1" />
          <RowDefinition Height="*" />
          <RowDefinition Height="1" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏：盘名 + 摘要 + 关闭 -->
        <Grid Grid.Row="0" Margin="18,16,18,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Grid Width="38" Height="38" VerticalAlignment="Center">
            <Ellipse Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6" />
            <Ellipse Width="16" Height="16" Stroke="{StaticResource AccentBrush}"
                     StrokeThickness="1.2" />
            <Ellipse Width="5" Height="5" Fill="{StaticResource AccentBrush}" />
          </Grid>

          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="DiscNameText" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="DiscSummaryText" FontSize="12" Margin="0,2,0,0"
                       Foreground="{StaticResource FaintBrush}" />
          </StackPanel>

          <Button x:Name="CloseButton" Grid.Column="2" Content="&#x2715;"
                  Style="{StaticResource GhostButton}" Padding="10,4" FontSize="13"
                  VerticalAlignment="Center" Click="OnCloseClick" ToolTip="关闭（Esc）" />
        </Grid>

        <Rectangle Grid.Row="1" Fill="{StaticResource LineBrush}" />

        <!-- 左边标题、右边章节 -->
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="TitleList" Margin="14,12" />
          </ScrollViewer>

          <Border Grid.Column="1" BorderThickness="1,0,0,0"
                  BorderBrush="{StaticResource LineBrush}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Grid Margin="18,14,18,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="章节" FontSize="15" FontWeight="SemiBold"
                             Foreground="{StaticResource TextBrush}" />
                  <TextBlock x:Name="ChapterCountText" FontSize="12" Margin="6,3,0,0"
                             Foreground="{StaticResource FaintBrush}" />
                </StackPanel>
                <TextBlock x:Name="ChapterMetaText" HorizontalAlignment="Right"
                           VerticalAlignment="Bottom" FontSize="12"
                           Foreground="{StaticResource FaintBrush}" />
              </Grid>

              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                <WrapPanel x:Name="ChapterList" Margin="18,0,18,14" />
              </ScrollViewer>

              <TextBlock x:Name="ChapterHint" Grid.Row="1"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextAlignment="Center" FontSize="12.5" LineHeight="20"
                         Foreground="{StaticResource FaintBrush}"
                         Text="这张盘没有章节标记&#x0a;点下面的「从头播放」整段播放。"
                         Visibility="Collapsed" />
            </Grid>
          </Border>
        </Grid>

        <Rectangle Grid.Row="3" Fill="{StaticResource LineBrush}" />

        <!-- 底部：播放 / 继续 -->
        <Grid Grid.Row="4" Margin="18,12">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="PlayButton" Content="从头播放"
                    Style="{StaticResource AccentButton}" Padding="18,9"
                    Click="OnPlayClick" />
            <Button x:Name="ResumeButton" Content="继续播放"
                    Style="{StaticResource GhostButton}" Padding="18,9"
                    Margin="8,0,0,0" Visibility="Collapsed"
                    Click="OnResumeClick" />
          </StackPanel>

          <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                     FontSize="11.5" Foreground="{StaticResource FaintBrush}"
                     Text="点章节可以直接从那一章开始" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
