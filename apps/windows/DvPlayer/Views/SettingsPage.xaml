<Page x:Class="DvPlayer.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgBrush}">

  <Grid Margin="32,40,32,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 统一工具条 -->
    <Grid Height="52">
      <TextBlock Text="设置" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
      <TextBlock x:Name="StatusText" HorizontalAlignment="Right" VerticalAlignment="Center"
                 FontSize="12.5" Foreground="{StaticResource FaintBrush}" />
    </Grid>

    <!-- 分段：通用 / 列表 / 播放 / 关于 -->
    <StackPanel Grid.Row="1" Margin="0,14,0,0">
      <Border Style="{StaticResource SegmentGroup}">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="GeneralSegment" Content="通用" GroupName="SettingsTab"
                       Style="{StaticResource SegmentItem}" IsChecked="True"
                       Checked="OnTabChanged" />
          <RadioButton x:Name="ListSegment" Content="列表" GroupName="SettingsTab"
                       Style="{StaticResource SegmentItem}" Margin="2,0,0,0"
                       Checked="OnTabChanged" />
          <RadioButton x:Name="PlaySegment" Content="播放" GroupName="SettingsTab"
                       Style="{StaticResource SegmentItem}" Margin="2,0,0,0"
                       Checked="OnTabChanged" />
          <RadioButton x:Name="ExtrasSegment" Content="弹幕 / 字幕" GroupName="SettingsTab"
                       Style="{StaticResource SegmentItem}" Margin="2,0,0,0"
                       Checked="OnTabChanged" />
          <RadioButton x:Name="TraktSegment" Content="Trakt" GroupName="SettingsTab"
                       Style="{StaticResource SegmentItem}" Margin="2,0,0,0"
                       Checked="OnTabChanged" />
          <RadioButton x:Name="AboutSegment" Content="关于" GroupName="SettingsTab"
                       Style="{StaticResource SegmentItem}" Margin="2,0,0,0"
                       Checked="OnTabChanged" />
        </StackPanel>
      </Border>
    </StackPanel>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden" Margin="0,18,0,0">
      <!-- 内容列最多 880，左边留白由右边的星号列吃掉（Stretch + MaxWidth 会居中）。 -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MaxWidth="880" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">

        <!-- 通用 -->
        <StackPanel x:Name="GeneralPanel">
          <Border Style="{StaticResource PanelCard}">
            <StackPanel>
              <TextBlock Text="启动" Style="{StaticResource SectionTitle}" FontSize="14" />

              <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="启动时自动连接" FontSize="14"
                             Foreground="{StaticResource TextBrush}" />
                  <TextBlock Text="打开 DV Player 后连接所有已配置的服务器"
                             FontSize="12.5" Foreground="{StaticResource FaintBrush}"
                             Margin="0,4,0,0" />
                </StackPanel>
                <ToggleButton x:Name="AutoConnectSwitch" Grid.Column="1"
                              Style="{StaticResource Switch}" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
              </Grid>

              <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="打开时显示" FontSize="14"
                             Foreground="{StaticResource TextBrush}" />
                  <TextBlock Text="启动后先看到哪一页" FontSize="12.5"
                             Foreground="{StaticResource FaintBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <ComboBox x:Name="StartPageBox" Grid.Column="1" Width="140" Height="34"
                          Style="{StaticResource Select}" VerticalAlignment="Center"
                          SelectionChanged="OnSettingChanged">
                  <ComboBoxItem Content="服务器" Tag="sources" />
                  <ComboBoxItem Content="每日推荐" Tag="daily" />
                  <ComboBoxItem Content="记录" Tag="records" />
                  <ComboBoxItem Content="搜索" Tag="search" />
                </ComboBox>
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource PanelCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="服务器" Style="{StaticResource SectionTitle}" FontSize="14" />
                <TextBlock x:Name="SourceSummaryText" FontSize="12.5"
                           Foreground="{StaticResource FaintBrush}" Margin="0,5,0,0" />
              </StackPanel>
              <Button Content="管理服务器" Grid.Column="1" Style="{StaticResource GhostButton}"
                      Padding="14,7" FontSize="12.5" VerticalAlignment="Center"
                      Click="OnManageSourcesClick" />
            </Grid>
          </Border>

          <Border Style="{StaticResource PanelCard}">
            <StackPanel>
              <TextBlock Text="每日推荐" Style="{StaticResource SectionTitle}" FontSize="14" />
              <TextBlock Text="打开应用时取 TMDB 和豆瓣的热门。媒体源里有的点开直接进详情，没有的可以一键推到 MoviePilot 订阅。"
                         FontSize="12.5" Foreground="{StaticResource FaintBrush}"
                         TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="18" />

              <TextBlock Text="TMDB API Key（可选）" Style="{StaticResource FieldLabel}" />
              <PasswordBox x:Name="TmdbKeyBox" Style="{StaticResource InputPassword}"
                           PasswordChanged="OnSettingPasswordChanged" />
              <TextBlock Text="在 themoviedb.org 免费申请 v3 API Key；填了才会显示 TMDB 趋势榜。"
                         FontSize="11.5" Foreground="{StaticResource FaintBrush}"
                         Margin="0,6,0,0" TextWrapping="Wrap" />

              <TextBlock Text="TMDB 代理（可选）" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="TmdbProxyBox" Style="{StaticResource Input}"
                       TextChanged="OnSettingTextChanged" />
              <TextBlock Text="留空跟随系统代理。只影响 TMDB 的 API 和海报，豆瓣 / MoviePilot 不走。"
                         FontSize="11.5" Foreground="{StaticResource FaintBrush}"
                         Margin="0,6,0,0" TextWrapping="Wrap" />

              <TextBlock Text="MoviePilot 地址" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="MoviePilotUrlBox" Style="{StaticResource Input}"
                       TextChanged="OnSettingTextChanged" />

              <TextBlock Text="MoviePilot API Token" Style="{StaticResource FieldLabel}" />
              <PasswordBox x:Name="MoviePilotTokenBox" Style="{StaticResource InputPassword}"
                           PasswordChanged="OnSettingPasswordChanged" />

              <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button Content="测试连接" Style="{StaticResource GhostButton}"
                        Padding="14,7" FontSize="12.5" Click="OnTestPilotClick" />
                <TextBlock x:Name="PilotStatusText" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" Margin="12,0,0,0"
                           TextWrapping="Wrap" MaxWidth="420" />
              </StackPanel>

              <TextBlock Text="MoviePilot「设置 → API」里可以拿到 Token；豆瓣条目没有 TMDB id，按标题识别，识别不到时会提示。"
                         FontSize="11.5" Foreground="{StaticResource FaintBrush}"
                         Margin="0,12,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- 列表 -->
        <StackPanel x:Name="ListPanel" Visibility="Collapsed">
          <Border Style="{StaticResource PanelCard}">
            <StackPanel>
              <TextBlock Text="媒体库" Style="{StaticResource SectionTitle}" FontSize="14" />

              <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="每页条数" FontSize="14"
                             Foreground="{StaticResource TextBrush}" />
                  <TextBlock Text="一次从服务器取多少条；滚动到底再取下一页"
                             FontSize="12.5" Foreground="{StaticResource FaintBrush}"
                             Margin="0,4,0,0" />
                </StackPanel>
                <ComboBox x:Name="PageSizeBox" Grid.Column="1" Width="104" Height="34"
                          Style="{StaticResource Select}" VerticalAlignment="Center"
                          SelectionChanged="OnSettingChanged">
                  <ComboBoxItem Content="40" />
                  <ComboBoxItem Content="60" />
                  <ComboBoxItem Content="100" />
                  <ComboBoxItem Content="200" />
                </ComboBox>
              </Grid>

              <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="显示分辨率角标" FontSize="14"
                             Foreground="{StaticResource TextBrush}" />
                  <TextBlock Text="在卡片右上角标出 1080P / 4K"
                             FontSize="12.5" Foreground="{StaticResource FaintBrush}"
                             Margin="0,4,0,0" />
                </StackPanel>
                <ToggleButton x:Name="ResolutionSwitch" Grid.Column="1"
                              Style="{StaticResource Switch}" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- 播放 -->
        <StackPanel x:Name="PlayPanel" Visibility="Collapsed">
          <Border Style="{StaticResource PanelCard}">
            <StackPanel>
              <TextBlock Text="播放器" Style="{StaticResource SectionTitle}" FontSize="14" />

              <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="从上次位置继续" FontSize="14"
                             Foreground="{StaticResource TextBrush}" />
                  <TextBlock Text="播放时跳到上次停下的位置" FontSize="12.5"
                             Foreground="{StaticResource FaintBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <ToggleButton x:Name="ResumeSwitch" Grid.Column="1"
                              Style="{StaticResource Switch}" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
              </Grid>

              <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="缓冲大小" FontSize="14"
                             Foreground="{StaticResource TextBrush}" />
                  <TextBlock Text="mpv 最多预读多少；默认 512 MB，原盘可以调到 2 GB / 4 GB"
                             FontSize="12.5" Foreground="{StaticResource FaintBrush}"
                             Margin="0,4,0,0" />
                </StackPanel>
                <ComboBox x:Name="BufferSizeBox" Grid.Column="1" Width="112" Height="34"
                          Style="{StaticResource Select}" VerticalAlignment="Center"
                          SelectionChanged="OnSettingChanged">
                  <ComboBoxItem Content="256 MB" Tag="256" />
                  <ComboBoxItem Content="512 MB" Tag="512" />
                  <ComboBoxItem Content="1 GB" Tag="1024" />
                  <ComboBoxItem Content="2 GB" Tag="2048" />
                  <ComboBoxItem Content="4 GB" Tag="4096" />
                </ComboBox>
              </Grid>

              <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="HDR 亮度参考" FontSize="14"
                             Foreground="{StaticResource TextBrush}" />
                  <TextBlock Text="HDR 片转 SDR 时的目标白点。默认自动（跟随系统）；觉得偏暗就选更小的值，SDR 内容不受影响。"
                             FontSize="12.5" Foreground="{StaticResource FaintBrush}"
                             Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox x:Name="HdrPeakBox" Grid.Column="1" Width="156" Height="34"
                          Style="{StaticResource Select}" VerticalAlignment="Center"
                          SelectionChanged="OnSettingChanged">
                  <ComboBoxItem Content="自动（跟随系统）" Tag="0" />
                  <ComboBoxItem Content="60 nit" Tag="60" />
                  <ComboBoxItem Content="80 nit" Tag="80" />
                  <ComboBoxItem Content="100 nit" Tag="100" />
                  <ComboBoxItem Content="120 nit" Tag="120" />
                  <ComboBoxItem Content="150 nit" Tag="150" />
                  <ComboBoxItem Content="180 nit" Tag="180" />
                  <ComboBoxItem Content="200 nit" Tag="200" />
                </ComboBox>
              </Grid>

            </StackPanel>
          </Border>

          <Border Style="{StaticResource PanelCard}">
            <StackPanel>
              <TextBlock Text="进度回写" Style="{StaticResource SectionTitle}" FontSize="14" />
              <TextBlock Text="播放中每 10 秒把位置写回源，关闭播放器时再写一次。飞牛与 Emby 各自用自己的接口。"
                         FontSize="12.5" Foreground="{StaticResource FaintBrush}"
                         TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="18" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- 弹幕 / 字幕 -->
        <StackPanel x:Name="ExtrasPanel" Visibility="Collapsed">
          <Border Style="{StaticResource PanelCard}">
            <StackPanel>
              <TextBlock Text="弹幕（弹弹play）" Style="{StaticResource SectionTitle}" FontSize="14" />
              <TextBlock Text="弹幕凭据已经内置在应用里，不用填任何东西；播放页「更多」里的弹幕开关打开后会按「剧名 + 集号」自动匹配。"
                         FontSize="12.5" Foreground="{StaticResource FaintBrush}"
                         TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="18" />

              <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="打开播放页时默认开弹幕" FontSize="14"
                             Foreground="{StaticResource TextBrush}" />
                  <TextBlock Text="关掉后每集都要手动点开" FontSize="12.5"
                             Foreground="{StaticResource FaintBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <ToggleButton x:Name="DanmakuSwitch" Grid.Column="1"
                              Style="{StaticResource Switch}" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
              </Grid>

              <TextBlock x:Name="DanmakuHint" FontSize="12" Foreground="{StaticResource FaintBrush}"
                         Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource PanelCard}">
            <StackPanel>
              <TextBlock Text="在线字幕（OpenSubtitles）" Style="{StaticResource SectionTitle}" FontSize="14" />
              <TextBlock Text="注册 OpenSubtitles 后就能拿到 API Key；用户名 / 密码可以不填，填了下载更稳。"
                         FontSize="12.5" Foreground="{StaticResource FaintBrush}"
                         TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="18" />

              <TextBlock Text="API Key" Style="{StaticResource FieldLabel}" />
              <PasswordBox x:Name="SubtitleKeyBox" Style="{StaticResource InputPassword}"
                           PasswordChanged="OnSettingPasswordChanged" />

              <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="用户名（可选）" Style="{StaticResource FieldLabel}" />
                  <TextBox x:Name="SubtitleUserBox" Style="{StaticResource Input}"
                           TextChanged="OnSettingTextChanged" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="密码（可选）" Style="{StaticResource FieldLabel}" />
                  <PasswordBox x:Name="SubtitlePassBox" Style="{StaticResource InputPassword}"
                               PasswordChanged="OnSettingPasswordChanged" />
                </StackPanel>
              </Grid>

              <TextBlock Text="搜索语言（逗号分隔）" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="SubtitleLangBox" Style="{StaticResource Input}"
                       TextChanged="OnSettingTextChanged"
                       ToolTip="默认 zh-cn,zh-tw,en" />

              <TextBlock x:Name="SubtitleHint" FontSize="12" Foreground="{StaticResource FaintBrush}"
                         Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Trakt -->
        <StackPanel x:Name="TraktPanel" Visibility="Collapsed">
          <Border Style="{StaticResource PanelCard}">
            <StackPanel>
              <TextBlock Text="Trakt（观看记录）" Style="{StaticResource SectionTitle}" FontSize="14" />
              <TextBlock Text="连接自己的 Trakt 账号：播放时自动上报进度，详情页可以评分、加入收藏 / 待看。数据只写到你的 Trakt 里，不经过我们的服务器。"
                         FontSize="12.5" Foreground="{StaticResource FaintBrush}"
                         TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="18" />

              <!-- 没有内置凭据的构建：让用户填自己的 Trakt 应用 -->
              <StackPanel x:Name="TraktCredentialPanel" Visibility="Collapsed" Margin="0,16,0,0">
                <TextBlock Text="这个构建没有内置 Trakt 应用凭据。去 Trakt 网站建一个 API 应用（Redirect URI 填 urn:ietf:wg:oauth:2.0:oob），把 Client ID / Secret 填在这里。"
                           FontSize="12" Foreground="{StaticResource FaintBrush}"
                           TextWrapping="Wrap" LineHeight="17" />
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Client ID" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TraktIdBox" Style="{StaticResource Input}"
                             TextChanged="OnSettingTextChanged" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Client Secret" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="TraktSecretBox" Style="{StaticResource InputPassword}"
                                 PasswordChanged="OnSettingPasswordChanged" />
                  </StackPanel>
                </Grid>
              </StackPanel>

              <!-- 账号状态 -->
              <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="TraktStatusText" Text="未连接" FontSize="14"
                             Foreground="{StaticResource TextBrush}" />
                  <TextBlock x:Name="TraktStatusHint" FontSize="12.5"
                             Foreground="{StaticResource FaintBrush}" Margin="0,4,0,0"
                             TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="TraktConnectButton" Content="连接 Trakt"
                          Style="{StaticResource GhostButton}" Click="OnTraktConnectClick" />
                  <Button x:Name="TraktLogoutButton" Content="断开"
                          Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                          Visibility="Collapsed" Click="OnTraktLogoutClick" />
                </StackPanel>
              </Grid>

              <!-- 设备码 -->
              <Border x:Name="TraktDevicePanel" Visibility="Collapsed" Margin="0,14,0,0"
                      Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="16">
                <StackPanel>
                  <TextBlock Text="在浏览器里打开 trakt.tv/activate，输入下面的码："
                             FontSize="12.5" Foreground="{StaticResource FaintBrush}"
                             TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock x:Name="TraktDeviceCode" Text="--------" FontSize="22"
                               FontWeight="SemiBold" FontFamily="Consolas"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <Button Content="打开网页" Style="{StaticResource GhostButton}"
                            Margin="16,0,0,0" Click="OnTraktOpenActivateClick" />
                    <Button Content="取消" Style="{StaticResource GhostButton}"
                            Margin="8,0,0,0" Click="OnTraktCancelClick" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="播放时自动同步观看进度" FontSize="14"
                             Foreground="{StaticResource TextBrush}" />
                  <TextBlock Text="关掉只是不再自动上报；详情页的评分 / 收藏仍可用"
                             FontSize="12.5" Foreground="{StaticResource FaintBrush}"
                             Margin="0,4,0,0" />
                </StackPanel>
                <ToggleButton x:Name="TraktEnabledSwitch" Grid.Column="1"
                              Style="{StaticResource Switch}" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
              </Grid>

              <TextBlock x:Name="TraktHint" FontSize="12" Foreground="{StaticResource FaintBrush}"
                         Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- 关于 -->
        <StackPanel x:Name="AboutPanel" Visibility="Collapsed">
          <Border Style="{StaticResource PanelCard}">
            <StackPanel>
              <TextBlock Text="版本" Style="{StaticResource SectionTitle}" FontSize="14" />

              <!-- 所有行共用一个 Grid：列宽只定义一次，值不会一行一个缩进 -->
              <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="DV Player" FontSize="13" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="AppVersionText" Grid.Column="1" FontSize="13"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />

                <TextBlock Text="共享核心" Grid.Row="1" Margin="0,10,0,0" FontSize="13"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="CoreVersionText" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"
                           FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />

                <!-- 项目地址：地址完整显示，点开默认浏览器 -->
                <TextBlock Text="项目" Grid.Row="2" Margin="0,10,0,0" FontSize="13"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="ProjectLink" Grid.Row="2" Grid.Column="1" Margin="0,10,0,0"
                           Text="github.com/wurxxx/dvplayer" FontSize="13"
                           Foreground="{StaticResource AccentBrush}"
                           TextDecorations="Underline" Cursor="Hand"
                           MouseLeftButtonUp="OnProjectLinkClick"
                           ToolTip="在浏览器中打开项目主页" VerticalAlignment="Center" />

                <!-- 更新：问 GitHub 最新 Release，和当前版本比 -->
                <TextBlock Text="更新" Grid.Row="3" Margin="0,10,0,0" FontSize="13"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="UpdateStatusText" Grid.Row="3" Grid.Column="1" Margin="0,10,0,0"
                           Text="还没有检查过" FontSize="13" Foreground="{StaticResource FaintBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button x:Name="UpdateButton" Grid.Row="3" Grid.Column="2" Content="检查更新"
                        Style="{StaticResource GhostButton}" Padding="12,5"
                        Margin="12,10,0,0" VerticalAlignment="Center"
                        Click="OnCheckUpdateClick" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
        </Grid>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>