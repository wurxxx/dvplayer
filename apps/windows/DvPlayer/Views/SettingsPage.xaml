<Page x:Class="DvPlayer.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgBrush}">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="36,30,36,36" MaxWidth="560" HorizontalAlignment="Left">

      <TextBlock Text="设置" Style="{StaticResource PageTitle}" />
      <TextBlock Text="管理媒体库来源" Style="{StaticResource Caption}" Margin="0,6,0,0" />

      <TextBlock Text="媒体源" Style="{StaticResource SectionTitle}" Margin="0,28,0,10" />

      <ItemsControl x:Name="SourceList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="11"
                    Padding="14,12" Margin="0,0,0,8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="34" Height="34" CornerRadius="9"
                        Background="#1FFFFFFF" Margin="0,0,12,0">
                  <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}"
                             FontSize="15" Foreground="{StaticResource MutedBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontSize="13.5"
                             Foreground="{StaticResource TextBrush}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Url}" FontSize="11.5"
                             Foreground="{StaticResource FaintBrush}" Margin="0,2,0,0"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Border Grid.Column="2" Background="#1FFFFFFF" CornerRadius="6"
                        Padding="8,2" VerticalAlignment="Center"
                        Visibility="{Binding BadgeVisibility}">
                  <TextBlock Text="{Binding Badge}" FontSize="10.5"
                             Foreground="{StaticResource AccentBrush}" />
                </Border>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12"
              Padding="20" Margin="0,20,0,0" Width="480" HorizontalAlignment="Left">
        <StackPanel>
          <TextBlock Text="添加飞牛影视" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="登录后即可浏览媒体库与播放记录。" Style="{StaticResource Caption}"
                     Margin="0,5,0,0" />

          <TextBlock Text="名称" Style="{StaticResource FieldLabel}" />
          <TextBox x:Name="NameBox" Text="飞牛影视" Style="{StaticResource Input}" />

          <TextBlock Text="服务器地址" Style="{StaticResource FieldLabel}" />
          <TextBox x:Name="BaseBox" Text="http://10.0.0.134:8005" Style="{StaticResource Input}" />

          <TextBlock Text="用户名" Style="{StaticResource FieldLabel}" />
          <TextBox x:Name="UserBox" Style="{StaticResource Input}" />

          <TextBlock Text="密码" Style="{StaticResource FieldLabel}" />
          <PasswordBox x:Name="PassBox" Style="{StaticResource InputPassword}" />

          <Button Content="添加并连接" Click="OnAddClick" Margin="0,20,0,0"
                  Style="{StaticResource AccentButton}" HorizontalAlignment="Left" />

          <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Margin="0,12,0,0"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <TextBlock x:Name="VersionText" Style="{StaticResource Caption}"
                 Margin="0,24,0,0" Foreground="{StaticResource FaintBrush}" />
    </StackPanel>
  </ScrollViewer>
</Page>
