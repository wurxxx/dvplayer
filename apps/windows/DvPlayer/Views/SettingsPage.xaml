<Page x:Class="DvPlayer.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#111114">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="40,32" MaxWidth="760" HorizontalAlignment="Left">

      <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold" Foreground="White" />
      <TextBlock Text="媒体源" FontSize="16" Foreground="#B8B8C0" Margin="0,28,0,12" />

      <ItemsControl x:Name="SourceList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="#1B1B20" CornerRadius="10" Padding="16,12" Margin="0,0,0,8">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Border Background="#2A2A31" CornerRadius="6" Padding="8,2" Margin="12,0,0,0">
                  <TextBlock Text="{Binding Badge}" Foreground="#8A8A93" FontSize="11" />
                </Border>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Background="#1B1B20" CornerRadius="12" Padding="20" Margin="0,20,0,0">
        <StackPanel>
          <TextBlock Text="添加飞牛影视" FontSize="15" FontWeight="SemiBold" Foreground="White" />

          <TextBlock Text="名称" Foreground="#9A9AA3" Margin="0,16,0,6" />
          <TextBox x:Name="NameBox" Text="飞牛影视" Padding="8" />

          <TextBlock Text="服务器地址" Foreground="#9A9AA3" Margin="0,12,0,6" />
          <TextBox x:Name="BaseBox" Text="http://10.0.0.134:8005" Padding="8" />

          <TextBlock Text="用户名" Foreground="#9A9AA3" Margin="0,12,0,6" />
          <TextBox x:Name="UserBox" Padding="8" />

          <TextBlock Text="密码" Foreground="#9A9AA3" Margin="0,12,0,6" />
          <PasswordBox x:Name="PassBox" Padding="8" />

          <Button Content="添加并连接" Click="OnAddClick" Margin="0,20,0,0"
                  Padding="18,10" HorizontalAlignment="Left" />

          <TextBlock x:Name="StatusText" Foreground="#9A9AA3" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
