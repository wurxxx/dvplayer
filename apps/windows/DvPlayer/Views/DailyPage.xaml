<Page x:Class="DvPlayer.Views.DailyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:DvPlayer.Controls"
      Background="{StaticResource BgBrush}">

  <Page.Resources>
    <!-- 一张推荐卡：海报 + 来源 / 评分 / 在库角标 + 标题 + 状态 -->
    <DataTemplate x:Key="DailyCardTemplate">
      <StackPanel Margin="0,0,0,22"
                  Width="{Binding CardSlot, RelativeSource={RelativeSource AncestorType=controls:PosterGrid}}">
        <Border CornerRadius="10" Background="{Binding Background}"
                Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=controls:PosterGrid}}"
                Height="{Binding CardHeight, RelativeSource={RelativeSource AncestorType=controls:PosterGrid}}"
                Tag="{Binding Id}" Cursor="Hand" SnapsToDevicePixels="True"
                MouseLeftButtonUp="OnCardClick">
          <Grid>
            <TextBlock Text="{Binding Initial}" FontSize="38" FontWeight="SemiBold"
                       Foreground="#2AFFFFFF" HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding PlaceholderVisibility}" />

            <!-- 评分 -->
            <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="8"
                    Background="{StaticResource AccentBrush}" CornerRadius="5" Padding="6,2"
                    Visibility="{Binding RatingVisibility}">
              <TextBlock Text="{Binding RatingText}" FontSize="11.5" FontWeight="SemiBold"
                         Foreground="#1A1200" />
            </Border>

            <!-- 来源 -->
            <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8"
                    Background="#73000000" CornerRadius="5" Padding="6,2">
              <TextBlock Text="{Binding Trend}" FontSize="10.5" Foreground="#E6FFFFFF" />
            </Border>

            <!-- 本地媒体源里已有 -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="8"
                    Background="#80000000" CornerRadius="5" Padding="6,2"
                    Visibility="{Binding MatchedVisibility}">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="5" Height="5" Fill="{StaticResource SuccessBrush}"
                         VerticalAlignment="Center" />
                <TextBlock Text="在库" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="White" Margin="4,0,0,0" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <TextBlock Text="{Binding Title}" FontSize="13" Margin="1,9,0,0"
                   Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=controls:PosterGrid}}"
                   Foreground="{StaticResource TextBrush}"
                   TextTrimming="CharacterEllipsis" />

        <StackPanel Orientation="Horizontal" Margin="1,2,0,0">
          <TextBlock Text="{Binding StateText}" FontSize="12"
                     Foreground="{Binding StateBrush}" />
          <TextBlock Text="{Binding SubText}" FontSize="12" Margin="6,0,0,0"
                     Foreground="{StaticResource FaintBrush}" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>
  </Page.Resources>

  <Grid Margin="32,40,32,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 工具条 -->
    <Grid Height="52">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="每日推荐" Style="{StaticResource PageTitle}" />
        <TextBlock x:Name="CountText" Style="{StaticResource Caption}"
                   VerticalAlignment="Center" Margin="12,0,0,0" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                  VerticalAlignment="Center">
        <TextBlock x:Name="StatusText" Style="{StaticResource Caption}"
                   VerticalAlignment="Center" Margin="0,0,14,0" />
        <Button x:Name="RefreshButton" Content="刷新" Style="{StaticResource GhostButton}"
                Padding="14,7" FontSize="12.5" Click="OnRefreshClick" />
      </StackPanel>
    </Grid>

    <!-- 提示：没填 TMDB Key / MoviePilot、抓取失败 -->
    <TextBlock x:Name="NotesText" Grid.Row="1" Style="{StaticResource Caption}"
               Margin="2,10,0,0" TextWrapping="Wrap" LineHeight="19"
               Visibility="Collapsed" />

    <!-- 加载 / 空态 -->
    <StackPanel x:Name="EmptyState" Grid.Row="2" HorizontalAlignment="Center"
                VerticalAlignment="Center" Margin="0,0,0,70" MaxWidth="420"
                Visibility="Collapsed">
      <TextBlock x:Name="EmptyGlyph" Text="&#xE734;" Style="{StaticResource EmptyIcon}" />
      <TextBlock x:Name="EmptyTitle" Text="今天还没有推荐"
                 Style="{StaticResource EmptyText}" FontSize="14" />
      <TextBlock x:Name="EmptyHint" Text="刷新一下试试，或者检查网络。"
                 Style="{StaticResource EmptyText}" FontSize="12.5" Margin="0,6,0,0"
                 Foreground="{StaticResource FaintBrush}" />
    </StackPanel>

    <!-- 推荐网格 -->
    <ScrollViewer x:Name="FeedScroll" Grid.Row="2" VerticalScrollBarVisibility="Hidden"
                  Margin="0,18,0,0" Visibility="Collapsed">
      <StackPanel Margin="0,0,0,28">
        <StackPanel x:Name="MovieSection">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="电影" Style="{StaticResource SectionTitle}" FontSize="16" />
            <TextBlock x:Name="MovieCount" Style="{StaticResource Caption}"
                       VerticalAlignment="Bottom" Margin="8,0,0,1" />
          </StackPanel>
          <controls:PosterGrid x:Name="MovieGrid"
                              ItemTemplate="{StaticResource DailyCardTemplate}" />
        </StackPanel>

        <StackPanel x:Name="SeriesSection" Margin="0,10,0,0">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="剧集" Style="{StaticResource SectionTitle}" FontSize="16" />
            <TextBlock x:Name="SeriesCount" Style="{StaticResource Caption}"
                       VerticalAlignment="Bottom" Margin="8,0,0,1" />
          </StackPanel>
          <controls:PosterGrid x:Name="SeriesGrid"
                              ItemTemplate="{StaticResource DailyCardTemplate}" />
        </StackPanel>

        <TextBlock Text="推荐来自 TMDB / 豆瓣，每天打开应用时更新一次；在媒体源里匹配到的条目可以直接打开，其余可以一键推到 MoviePilot 订阅。"
                   Style="{StaticResource Caption}" Margin="2,8,0,0"
                   TextWrapping="Wrap" LineHeight="18" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
