<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    浅色色板：和 Palette.Dark.xaml 同一套 key，只换值。
    不是把深色反色：浅色下卡片用纯白、分层靠 1px 描边和悬停底（浅色阴影很弱），
    强调色拆成「填充」「文字 / 图标」「选中块底」「填充上的文字」四档；
    这里的琥珀只是默认值，换主题色后由 ThemeService 覆盖（见 AccentTheme.cs）。

    对比度（相对页面 #F4F5F7 / 卡片 #FFFFFF）：
      正文 171A20  ≈ 16.4 / 17.3
      次级 4B5361  ≈  8.0 /  8.4
      弱化 667080  ≈  4.6 /  5.0（12.5px 小字也过 AA）
      强调文字 996300 ≈ 4.7 / 5.1
  -->

  <Color x:Key="BgColor">#F4F5F7</Color>
  <Color x:Key="SidebarColor">#FBFBFD</Color>
  <Color x:Key="SurfaceColor">#FFFFFF</Color>
  <Color x:Key="SurfaceHoverColor">#ECEFF4</Color>
  <Color x:Key="LineColor">#D7DBE2</Color>
  <Color x:Key="TextColor">#171A20</Color>
  <Color x:Key="MutedColor">#4B5361</Color>
  <Color x:Key="FaintColor">#667080</Color>
  <Color x:Key="AccentColor">#FFB020</Color>
  <Color x:Key="OnAccentColor">#1A1200</Color>
  <Color x:Key="AccentInkColor">#996300</Color>
  <Color x:Key="DangerColor">#C8261B</Color>
  <Color x:Key="SuccessColor">#15803D</Color>
  <Color x:Key="HeroFadeColor">#F4F5F7</Color>

  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
  <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
  <SolidColorBrush x:Key="FaintBrush" Color="{StaticResource FaintColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
  <SolidColorBrush x:Key="AccentInkBrush" Color="{StaticResource AccentInkColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />

  <!-- 压在图上用的绿：「在库」角标底是半透明黑，浅色的深绿读不清。 -->
  <SolidColorBrush x:Key="SuccessOnImageBrush" Color="#4ADE80" />
  <SolidColorBrush x:Key="NavHoverBrush" Color="#0E000000" />

  <SolidColorBrush x:Key="ChipBrush" Color="#14000000" />
  <SolidColorBrush x:Key="HairlineBrush" Color="#14000000" />

  <SolidColorBrush x:Key="SwitchTrackBrush" Color="#CDD2DA" />
  <SolidColorBrush x:Key="SwitchKnobBrush" Color="#FFFFFF" />

  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#33000000" />
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#4D000000" />
  <SolidColorBrush x:Key="ScrollThumbDragBrush" Color="#66000000" />

  <SolidColorBrush x:Key="ControlHoverLineBrush" Color="#A9B0BC" />

  <SolidColorBrush x:Key="HeroFadeBrush" Color="{StaticResource HeroFadeColor}" />

  <SolidColorBrush x:Key="AccentSoftBrush" Color="#FDF5E7" />

  <SolidColorBrush x:Key="HeroChipBrush" Color="#D9FFFFFF" />
  <SolidColorBrush x:Key="HeroChipHoverBrush" Color="#F2FFFFFF" />

  <SolidColorBrush x:Key="GlassPanelBrush" Color="#CCFFFFFF" />

  <SolidColorBrush x:Key="DotActiveBrush" Color="#E6171A20" />
  <SolidColorBrush x:Key="DotIdleBrush" Color="#59171A20" />

  <!--
    浅色下大图不是「压暗」，是淡到页面底色：图片下半部洗成浅色，
    上面的文字也就跟着换成深色（页面里的正文色）。
    顶部留一点淡黑，保证白色返回箭头压在亮图上还看得见。
  -->
<!--
    详情页 hero 上的一层黑：有图时白字压在画面上才读得清。
    HeroScrimBrush 只负责把底边淡到页面底色，压暗全交给这一层。
  -->
  <LinearGradientBrush x:Key="HeroInkVeilBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#4D000000" Offset="0" />
    <GradientStop Color="#1F000000" Offset="0.18" />
    <GradientStop Color="#4D000000" Offset="0.48" />
    <GradientStop Color="#6B000000" Offset="0.62" />
    <GradientStop Color="#80000000" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="HeroScrimBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#00F4F5F7" Offset="0" />
    <GradientStop Color="#00F4F5F7" Offset="0.84" />
    <GradientStop Color="#3DF4F5F7" Offset="0.90" />
    <GradientStop Color="#8CF4F5F7" Offset="0.95" />
    <GradientStop Color="#D9F4F5F7" Offset="0.98" />
    <GradientStop Color="#FFF4F5F7" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="HeroSideScrimBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#40000000" Offset="0" />
    <GradientStop Color="#17000000" Offset="0.42" />
    <GradientStop Color="#00000000" Offset="0.70" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="OverviewFadeBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#00F4F5F7" Offset="0" />
    <GradientStop Color="#3DF4F5F7" Offset="0.3" />
    <GradientStop Color="#8CF4F5F7" Offset="0.55" />
    <GradientStop Color="#C7F4F5F7" Offset="0.75" />
    <GradientStop Color="#EBF4F5F7" Offset="0.88" />
    <GradientStop Color="#FFF4F5F7" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="TopBarScrimBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#B8F4F5F7" Offset="0" />
    <GradientStop Color="#4DF4F5F7" Offset="0.55" />
    <GradientStop Color="#00F4F5F7" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="TopBarScrimStrongBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#E6F4F5F7" Offset="0" />
    <GradientStop Color="#99F4F5F7" Offset="0.5" />
    <GradientStop Color="#00F4F5F7" Offset="1" />
  </LinearGradientBrush>

</ResourceDictionary>
