<Window x:Class="DvPlayer.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DV Player"
        Width="512"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}"
        Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display"
        PreviewMouseLeftButtonDown="OnWindowMouseDown"
        FocusManager.FocusedElement="{Binding ElementName=CancelButton}">

  <!-- 和界面同一套深色圆角卡片：系统 MessageBox 是浅色的，在深色 app 里很扎眼。 -->
  <Grid Margin="24">
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1"
            CornerRadius="16">
      <Border.Effect>
        <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.55" Color="#000000" />
      </Border.Effect>

      <StackPanel Margin="24,22,24,20">
        <StackPanel Orientation="Horizontal">
          <Border x:Name="IconBadge" Width="34" Height="34" CornerRadius="10" Background="#26FF6B6B">
            <TextBlock x:Name="IconGlyph" Text="&#xE7BA;"
                       FontFamily="{StaticResource IconFont}" FontSize="16"
                       Foreground="{StaticResource DangerBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>

          <TextBlock x:Name="TitleText" Text="提示"
                     FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold"
                     Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                     Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <TextBlock x:Name="MessageText" FontSize="13.5"
                   Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap" LineHeight="21" Margin="0,14,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
          <Button x:Name="CancelButton" Content="取消" IsCancel="True"
                  Style="{StaticResource GhostButton}" Padding="18,8"
                  Click="OnCancelClick" />
          <Button x:Name="ConfirmButton" Content="确定"
                  Style="{StaticResource DangerButton}" Padding="18,8"
                  Margin="8,0,0,0" Click="OnConfirmClick" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
