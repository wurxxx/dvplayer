<Window x:Class="DvPlayer.Dialogs.DiscTitlesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DV Player"
        Width="560"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}"
        Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display"
        PreviewMouseLeftButtonDown="OnWindowMouseDown"
        FocusManager.FocusedElement="{Binding ElementName=PlayButton}">

  <!-- 和确认框同一套深色卡片：选正片 / 花絮也留在应用自己的视觉里。 -->
  <Grid Margin="24">
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1"
            CornerRadius="16">
      <Border.Effect>
        <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.55" Color="#000000" />
      </Border.Effect>

      <StackPanel Margin="22,20,22,18">
        <StackPanel Orientation="Horizontal">
          <Border Width="34" Height="34" CornerRadius="10" Background="#26FFB020">
            <TextBlock Text="&#xE958;" FontFamily="{StaticResource IconFont}" FontSize="16"
                       Foreground="{StaticResource AccentBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>

          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="打开蓝光原盘" FontFamily="{StaticResource DisplayFont}"
                       FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
            <TextBlock x:Name="SubtitleText" FontSize="12" Foreground="{StaticResource FaintBrush}"
                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </StackPanel>

        <ListBox x:Name="TitlesList"
                 Margin="0,16,0,0"
                 MaxHeight="360"
                 Background="Transparent"
                 BorderThickness="0"
                 ItemContainerStyle="{StaticResource NavItem}"
                 SelectionChanged="OnSelectionChanged"
                 MouseDoubleClick="OnListDoubleClick">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Background="#1FFFFFFF" CornerRadius="6" Padding="7,2"
                        VerticalAlignment="Center">
                  <TextBlock Text="{Binding Badge}" FontSize="11"
                             Foreground="{StaticResource AccentBrush}" />
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,10,0">
                  <TextBlock Text="{Binding Name}" FontSize="13.5"
                             Foreground="{StaticResource TextBrush}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Detail}" FontSize="11.5"
                             Foreground="{StaticResource FaintBrush}" Margin="0,2,0,0"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding Duration}" FontSize="12.5"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="双击或按回车直接播放选中的标题"
                   FontSize="11.5" Foreground="{StaticResource FaintBrush}"
                   Margin="2,12,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
          <Button Content="取消" IsCancel="True"
                  Style="{StaticResource GhostButton}" Padding="18,8"
                  Click="OnCancelClick" />
          <Button x:Name="PlayButton" Content="播放"
                  Style="{StaticResource AccentButton}" Padding="20,8"
                  Margin="8,0,0,0" IsDefault="True" Click="OnPlayClick" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
