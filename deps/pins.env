# 依赖钉版本
#
# M0 使用 Homebrew 的二进制包；M1 起改为 vendored 构建，以这里为准。

# vendored 构建标签（M1+）
MPV_TAG=v0.42.0
FFMPEG_TAG=n9.0.2
LIBPLACEBO_TAG=v7.387.0

# M0 实测的 Homebrew 版本（2026-11-19）
BREW_MPV=0.42.0
BREW_FFMPEG=9.0.2
BREW_LIBPLACEBO=7.387.0

# 说明
# - mpv 0.42 要求 libplacebo >= 7.387.0（FEL API, PL_API_VER >= 370）
# - FFmpeg 必须 >= 9.0 才有 dovi_split
# - dovi_tool 版本在 M0 由 brew 提供，记录见 docs/M0.md
