# 依赖钉版本
#
# 构建方式：scripts/build-deps-macos.sh → prefix/
# 全部为源码构建（dovi_tool 用官方预编译二进制）。

# vendored 构建标签
MPV_TAG=v0.42.0
FFMPEG_TAG=n9.0.2
LIBPLACEBO_TAG=v7.387.0
LIBASS_TAG=0.17.4
DOVI_TOOL_TAG=2.3.4

# M0 实测版本（2026-11-19，macOS 26.4.1 / x86_64）
BUILT_MPV=0.42.0
BUILT_FFMPEG=9.0.2
BUILT_LIBPLACEBO=7.387.0
BUILT_LIBASS=0.17.4
BUILT_DOVI_TOOL=2.3.4

# 说明
# - mpv 0.42 要求 libplacebo >= 7.387.0（FEL API, PL_API_VER >= 370）
# - FFmpeg 必须 >= 9.0 才有 dovi_split
# - libass 是 mpv 0.42 的硬依赖，没有关闭选项
# - mpv 需要打 patches/mpv/0001-view-cametal-layer.patch（关 Vulkan 时的编译错误）
